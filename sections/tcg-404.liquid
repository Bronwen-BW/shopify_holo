{%- comment -%}
  TCG 404 页面（对齐参考站 not found）
  创意：数字 4 + 卡牌槽（月亮伊布）+ 数字 4
{%- endcomment -%}

{%- assign req_path_down = request.path | downcase -%}
{%- assign req_slug = req_path_down | split: '/' | last | split: '?' | first -%}
{%- if req_path_down == '/pages/custom' or req_path_down == '/pages/custom/' or req_slug == 'custom' or req_slug == 'custom-catalog' -%}
  {% render 'tcg-custom-catalog-view', section: section %}
{%- elsif req_path_down contains '/pages/custom-' or req_path_down contains '/products/custom-' or req_slug contains 'custom-' -%}
  {% render 'tcg-custom-product-form', section: section, custom_handle: req_slug %}
{%- else -%}
<main class="_page_5xn5p_1">
  <section class="_content_5xn5p_34" aria-labelledby="not-found-title">
    <span class="_eyebrow_5xn5p_44">Lost in the collection</span>

    <div class="_errorCode_5xn5p_53" aria-label="Error 404">
      <span>4</span>
      <figure class="_cardSlot_5xn5p_67"><img src="{{ 'card-umbreon.png' | asset_url }}" alt=""></figure>
      <span>4</span>
    </div>

    <h1 id="not-found-title">This page slipped out of its sleeve.</h1>
    <p>The link may be outdated, or the page may have moved somewhere else in the collection.</p>

    <nav class="_actions_5xn5p_99" aria-label="Not found page navigation">
      <a href="{{ routes.root_url }}" class="_primaryAction_5xn5p_108">Return home</a>
      <a href="{{ routes.all_products_collection_url }}" class="_secondaryAction_5xn5p_109">Browse the shop</a>
    </nav>
  </section>

  <span class="_reference_5xn5p_45" aria-hidden="true">MLH / 404</span>
</main>
{%- endif -%}

{% schema %}
{
  "name": "TCG 404",
  "settings": []
}
{% endschema %}
