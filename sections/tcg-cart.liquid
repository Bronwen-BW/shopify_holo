{%- comment -%}
  TCG 购物车页（保留现有 TCG 外观，核心加购、数量修改、折扣码、备注与官方支付流程完全对齐参考模板 main-cart.liquid / cart-products.liquid / cart-summary.liquid）
{%- endcomment -%}

<div
  class="_page_1z0wo_1"
  data-tcg-cart-section
  data-section-id="{{ section.id }}"
  data-currency-sample="{{ 1000 | money | escape }}"
  data-cart-url="{{ routes.cart_url }}"
  data-checkout-url="{{ routes.cart_checkout_url }}"
  data-shop-url="{{ routes.all_products_collection_url }}"
>
  <div class="_wide_4xdw3_6">

    {%- comment %} 购物车模式：保留 1. Cart -> 2. Checkout & Payment -> 3. Confirmation 三步进度条 {% endcomment -%}
    <ol class="_steps_16l9l_44" data-cart-steps-bar aria-label="Checkout progress" style="margin-bottom:clamp(1.5rem,4vh,2.5rem);width:fit-content;">
      <li class="_stepCurrent_16l9l_96" aria-current="step">
        <a href="{{ routes.cart_url }}" class="_stepLink_16l9l_54">
          <span class="_stepDot_16l9l_76" aria-hidden="true">1</span>
          <span class="_stepLabel_16l9l_225">Cart</span>
        </a>
      </li>
      <li>
        <a href="{{ routes.cart_checkout_url }}" class="_stepLink_16l9l_54" data-checkout-step-link>
          <span class="_stepDot_16l9l_76" aria-hidden="true">2</span>
          <span class="_stepLabel_16l9l_225">Checkout &amp; Payment</span>
        </a>
      </li>
      <li>
        <span class="_stepLink_16l9l_54">
          <span class="_stepDot_16l9l_76" aria-hidden="true">3</span>
          <span class="_stepLabel_16l9l_225">Confirmation</span>
        </span>
      </li>
    </ol>

    {%- comment %} 立即购买（Buy it now）中间界面专属：仅保留 1. Checkout & Payment -> 2. Confirmation 两步进度条 {% endcomment -%}
    <ol class="_steps_16l9l_44" data-buy-now-steps-bar aria-label="Buy it now progress" style="margin-bottom:clamp(1.5rem,4vh,2.5rem);width:fit-content;" hidden>
      <li class="_stepCurrent_16l9l_96" aria-current="step">
        <span class="_stepLink_16l9l_54">
          <span class="_stepDot_16l9l_76" aria-hidden="true">1</span>
          <span class="_stepLabel_16l9l_225">Checkout &amp; Payment</span>
        </span>
      </li>
      <li>
        <span class="_stepLink_16l9l_54">
          <span class="_stepDot_16l9l_76" aria-hidden="true">2</span>
          <span class="_stepLabel_16l9l_225">Confirmation</span>
        </span>
      </li>
    </ol>

    <span class="visually-hidden" ref="cartItemCount" data-cart-hidden-count aria-hidden="true" hidden>{{- cart.item_count -}}</span>

    <div data-cart-filled-view {% if cart.item_count == 0 %}hidden{% endif %}>
      <header class="_header_1z0wo_6" data-cart-header>
        <h1 class="_heading_1z0wo_14">
          <span data-cart-heading-title>{{ section.settings.heading | default: 'Your cart' }}</span>
          <span class="_count_1z0wo_27" data-cart-header-count> ({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})</span>
        </h1>
        <div style="display:flex;align-items:center;gap:1rem;">
          <a href="{{ routes.cart_url }}" class="tcg-link-accent" data-exit-buy-now-link hidden>View full cart →</a>
          <a href="{{ routes.all_products_collection_url }}" class="tcg-link-subtle" data-continue-shopping-link>← Continue shopping</a>
        </div>
      </header>

      {%- comment %}
        对齐参考模板 snippets/cart-products.liquid + snippets/cart-summary.liquid：
        使用官方 <form action="{{ routes.cart_url }}" method="post" id="cart-form">
        结账按钮使用 <button type="submit" id="checkout" name="checkout" form="cart-form"> 提交到 Shopify 官方支付流程
      {%- endcomment -%}
      <form
        action="{{ routes.cart_url }}"
        method="post"
        id="cart-form"
        class="_layout_1z0wo_34 cart-form"
        data-tcg-official-cart-form
      >
        <div class="_list_1z0wo_46">
          <div data-shopify-cart-items class="tcg-cart-items-group">
          {%- for item in cart.items -%}
            {%- if item.image != blank -%}
              {%- assign item_img = item.image | image_url: width: 240 -%}
            {%- else -%}
              {%- assign item_img = 'logo-mark.png' | asset_url -%}
            {%- endif -%}

            <div
              class="_row_1z0wo_52"
              ref="cartItemRows[]"
              data-cart-row
              data-cart-source="shopify"
              data-line="{{ forloop.index }}"
              data-key="{{ item.key }}"
              data-parent-key="{{ item.parent_relationship.parent.key }}"
              data-variant-id="{{ item.variant_id }}"
              data-original-unit-price="{{ item.original_price }}"
              data-unit-price="{{ item.final_price }}"
              data-original-line-price="{{ item.original_line_price }}"
              data-line-price="{{ item.final_line_price }}"
              data-line-discount="{{ item.line_level_total_discount }}"
              data-quantity="{{ item.quantity }}"
            >
              <a href="{{ item.url }}" class="_thumb_1z0wo_62">
                <img alt="{{ item.title | escape }}" draggable="false" src="{{ item_img }}" loading="lazy">
              </a>

              <div class="_rowInfo_1z0wo_78">
                <a href="{{ item.url }}" class="_rowName_1z0wo_86">{{ item.product.title }}</a>

                <div class="tcg-cart-meta">
                  {%- if item.variant.title != 'Default Title' -%}
                    <span class="_rowUnitPrice_1z0wo_94">{{ item.variant.title }}</span>
                  {%- endif -%}
                  {%- if item.sku != blank -%}
                    <code class="tcg-sku-code">SKU: {{ item.sku }}</code>
                  {%- endif -%}
                  <span class="_rowUnitPrice_1z0wo_94" data-row-unit-price>{{ item.original_price | money }} each</span>
                </div>

                <div class="_qtyControl_1z0wo_100" data-cart-qty>
                  <button
                    type="button"
                    name="minus"
                    class="_qtyBtn_1z0wo_110"
                    data-cart-minus
                    data-line="{{ forloop.index }}"
                    aria-label="Decrease quantity"
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14"></path></svg>
                  </button>
                  <input
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    data-cart-quantity="{{ item.quantity }}"
                    min="0"
                    data-min="{{ item.variant.quantity_rule.min | default: 1 }}"
                    {% if item.variant.quantity_rule.max %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
                    step="{{ item.variant.quantity_rule.increment | default: 1 }}"
                    aria-label="Quantity for {{ item.title | escape }}"
                    class="tcg-cart-qty-input"
                    ref="quantityInput"
                    data-cart-qty-input
                    data-cart-line="{{ forloop.index }}"
                    data-line="{{ forloop.index }}"
                  >
                  <span class="_qtyValue_1z0wo_135" hidden>{{ item.quantity }}</span>
                  <button
                    type="button"
                    name="plus"
                    class="_qtyBtn_1z0wo_110"
                    data-cart-plus
                    data-line="{{ forloop.index }}"
                    aria-label="Increase quantity"
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
                  </button>
                </div>

                <p class="tcg-form-error" data-cart-line-error="{{ forloop.index }}" hidden></p>
              </div>

              <div class="_rowEnd_1z0wo_145">
                <del class="tcg-line-compare" data-row-line-compare hidden>{{ item.original_line_price | money }}</del>
                <span class="_lineTotal_1z0wo_152" data-row-line-total>{{ item.original_line_price | money }}</span>
                <button
                  type="button"
                  class="_removeBtn_1z0wo_160"
                  data-cart-remove
                  data-line="{{ forloop.index }}"
                  aria-label="Remove {{ item.title | escape }}"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path></svg>Remove
                </button>
              </div>
            </div>
          {%- endfor -%}
          </div>

          <div data-storefront-cart-items class="tcg-cart-items-group"></div>

          {%- if section.settings.show_cart_note != false -%}
            <div class="tcg-cart-note-card">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
                <label for="cart-note" class="tcg-field-label">Order note / Packing instructions</label>
                <span class="tcg-note-status" data-cart-note-status hidden style="font-size:0.75rem;color:#34d399;font-weight:600;">✓ Saved to order</span>
              </div>
              <textarea
                form="cart-form"
                name="note"
                id="cart-note"
                class="tcg-textarea"
                rows="3"
                autocomplete="off"
                placeholder="Add special packing or delivery notes for our warehouse…"
                data-cart-note
              ></textarea>
            </div>
          {%- endif -%}
        </div>

        {%- comment %} 订单汇总与 Shopify 官方支付结账侧栏（参考 snippets/cart-summary.liquid） {% endcomment -%}
        <aside class="_summary_1z0wo_183">
          <h2 class="_summaryTitle_1z0wo_199">Order summary</h2>

          <div class="_summaryRow_1z0wo_208" data-summary-stats data-server-original-total="{{ cart.original_total_price }}" data-server-total-discount="{{ cart.total_discount }}" data-server-total-price="{{ cart.total_price }}">
            <span>Items (<span data-summary-item-count>{{ cart.item_count }}</span>)</span>
            <span data-summary-subtotal data-testid="cart-subtotal-value">{{ cart.original_total_price | money }}</span>
          </div>

          <div class="_summaryRow_1z0wo_208 tcg-summary-discount" data-summary-discount-row hidden>
            <span>Discounts</span>
            <span data-summary-discount>-$0.00</span>
          </div>

          <div class="_summaryRow_1z0wo_208">
            <span>Shipping</span>
            <span>Calculated at checkout</span>
          </div>

          {%- if section.settings.show_discount_box != false -%}
            <div class="tcg-discount-field" data-cart-discount-wrapper data-section-id="{{ section.id }}">
              <label for="cart-discount" class="tcg-field-label">Discount / Promo code</label>
              <div style="display:flex;gap:0.5rem;align-items:center;">
                <input
                  type="text"
                  name="discount"
                  id="cart-discount"
                  value=""
                  autocomplete="off"
                  class="tcg-input"
                  placeholder="Enter promo code"
                  data-cart-discount
                >
                <button
                  type="button"
                  class="tcg-btn-secondary"
                  style="min-height:2.75rem;padding:0.5rem 1rem;flex-shrink:0;"
                  data-apply-discount-btn
                >
                  Apply
                </button>
              </div>
              <p class="tcg-form-error" data-cart-discount-error hidden style="margin-top:0.4rem;">Invalid or inapplicable discount code.</p>
              <ul class="tcg-cart-discounts" data-cart-discount-pills style="list-style:none;padding:0;margin:0.5rem 0 0;display:flex;flex-wrap:wrap;gap:0.4rem;"></ul>
            </div>
          {%- endif -%}

          <div class="_summaryTotal_1z0wo_221">
            <span>Estimated total</span>
            <span data-summary-total data-testid="cart-total-value" data-cart-subtotal>{{ cart.original_total_price | money }}</span>
          </div>

          {%- if settings.show_installments -%}
            <div class="cart-totals__installments" style="font-size:0.8125rem;color:#a1a1aa;">
              {{ form | payment_terms }}
            </div>
          {%- endif -%}

          {%- comment %}
            核心：与参考模板 snippets/cart-summary.liquid 完全一致的官方 Checkout 提交按钮
            点击后通过 POST /cart (带 name="checkout") 由 Shopify 服务端创建/恢复 Checkout 会话并 302 跳转至 Shopify 官方支付页面
          {%- endcomment -%}
          <div class="cart__ctas" style="display:grid;gap:0.6rem;width:100%;">
            <button
              type="submit"
              id="checkout"
              name="checkout"
              form="cart-form"
              class="_checkoutBtn_1z0wo_241 cart__checkout-button button"
              data-official-checkout-submit
              {% if cart == empty %}disabled{% endif %}
            >
              <span class="button-text">
                {{ section.settings.checkout_label | default: 'Go to checkout' }}
              </span>
            </button>

            {%- if additional_checkout_buttons and settings.show_accelerated_checkout_buttons != false -%}
              <div class="additional-checkout-buttons additional-checkout-buttons--vertical tcg-additional-checkout">
                {{ content_for_additional_checkout_buttons }}
              </div>
            {%- endif -%}
          </div>

          <p class="_summaryNote_1z0wo_291">
            {{ section.settings.security_note | default: 'Secure payment via Shopify Checkout. Taxes and shipping calculated before payment.' }}
          </p>
        </aside>
      </form>
    </div>

    {%- comment %} 空购物车状态 {% endcomment -%}
    <div class="_empty_1z0wo_298" data-cart-empty-view {% if cart.item_count > 0 %}hidden{% endif %}>
      <span class="_emptyIcon_1z0wo_311">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path></svg>
      </span>
      <h2 class="_emptyTitle_1z0wo_326">Your cart is empty</h2>
      <p class="_emptyText_1z0wo_334">Browse the newest sealed products and singles, then add them here.</p>
      <a href="{{ settings.empty_cart_button_link | default: routes.all_products_collection_url }}" class="_emptyCta_1z0wo_340">Start shopping</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TCG 购物车",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "页面标题",
      "default": "Your cart"
    },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "显示订单备注输入框",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_discount_box",
      "label": "显示折扣码输入框",
      "default": true
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "结账按钮文字",
      "default": "Go to checkout"
    },
    {
      "type": "text",
      "id": "security_note",
      "label": "底部安全提示文字",
      "default": "Secure payment via Shopify Checkout. Taxes and shipping calculated before payment."
    }
  ],
  "presets": [
    {
      "name": "TCG 购物车"
    }
  ]
}
{% endschema %}
