{%- comment -%}
  TCG Shop by set：大卡轨道，每个 block 绑定一个集合
  显示集合封面图、游戏名、系列名、产品数量（未绑定集合时提供美观默认图与标题回退）
{%- endcomment -%}
{%- assign fallback_arts = 'card-charizard.png,card-palkia.png,card-umbreon.png,card-blastoise.png' | split: ',' -%}
{%- assign fallback_titles = 'Scarlet & Violet — 151,Modern Horizons & Commander,Prismatic Evolutions,Collectors Vault' | split: ',' -%}

<section class="_section_qxt27_1">
  <div class="_wide_qxt27_5">
    <header class="_header_qxt27_10">
      <div>
        <h2>{{ section.settings.heading | default: 'Shop by set' }}</h2>
        <p>{{ section.settings.subheading | default: 'The sets we carry the most sealed products and singles from right now.' }}</p>
      </div>
      <a href="{{ routes.all_products_collection_url }}" class="_viewAll_qxt27_33">All products</a>
    </header>

    <div class="_rail_qxt27_81" style="--tcg-sets-cols: {{ section.settings.columns_desktop | default: 4 }};">
      {%- for block in section.blocks -%}
        {%- assign set_col = collections[block.settings.collection] -%}
        {%- assign fb_idx = forloop.index0 | modulo: fallback_arts.size -%}
        {%- assign set_title = block.settings.title | default: set_col.title | default: fallback_titles[fb_idx] -%}
        {%- assign set_count = set_col.products_count | default: collections.all.products_count | default: 12 -%}

        <a
          data-motion-card="9"
          href="{{ set_col.url | default: routes.all_products_collection_url }}"
          class="_collection_qxt27_87"
          data-reveal
          style="--frame: {{ block.settings.frame_color | default: '#2ed39a' }};"
          {{ block.shopify_attributes }}
        >
          <span class="_media_qxt27_116" aria-hidden="true">
            {%- if block.settings.image != blank -%}
              <img data-motion-art src="{{ block.settings.image | image_url: width: 600 }}" alt="" draggable="false" loading="lazy">
            {%- elsif set_col.featured_image != blank -%}
              <img data-motion-art src="{{ set_col.featured_image | image_url: width: 600 }}" alt="" draggable="false" loading="lazy">
            {%- else -%}
              <img data-motion-art src="{{ fallback_arts[fb_idx] | asset_url }}" alt="" draggable="false" loading="lazy">
            {%- endif -%}
          </span>
          <span class="_body_qxt27_137">
            <span class="_game_qxt27_152">{{ block.settings.game_label | default: 'Pokémon' }}</span>
            <h3>{{ set_title }}</h3>
            <span class="_count_qxt27_159">{{ set_count }} products</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG 系列轨道",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Shop by set" },
    { "type": "text", "id": "subheading", "label": "副标题", "default": "The sets we carry the most sealed products and singles from right now." },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "桌面端每行显示格数",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "set",
      "name": "系列",
      "settings": [
        { "type": "collection", "id": "collection", "label": "绑定集合" },
        { "type": "text", "id": "game_label", "label": "游戏名", "default": "Pokémon" },
        { "type": "text", "id": "title", "label": "系列名称覆盖（留空取集合名）" },
        { "type": "image_picker", "id": "image", "label": "封面图覆盖（留空取集合封面图）" },
        {
          "type": "select",
          "id": "frame_color",
          "label": "主题色",
          "default": "#2ed39a",
          "options": [
            { "value": "#2ed39a", "label": "Pokémon 绿" },
            { "value": "#a78bfa", "label": "Yu-Gi-Oh 紫" },
            { "value": "#f28753", "label": "Magic 橙" },
            { "value": "#c084fc", "label": "Lorcana 紫" },
            { "value": "#7dd3fc", "label": "Riftbound 天蓝" },
            { "value": "#60a5fa", "label": "Digimon 蓝" },
            { "value": "#facc15", "label": "Cyberpunk 黄" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TCG 系列轨道",
      "blocks": [
        { "type": "set", "settings": { "game_label": "Pokémon", "title": "Scarlet & Violet — 151", "frame_color": "#2ed39a" } },
        { "type": "set", "settings": { "game_label": "Magic: The Gathering", "title": "Modern Horizons & Commander", "frame_color": "#f28753" } },
        { "type": "set", "settings": { "game_label": "Pokémon", "title": "Prismatic Evolutions", "frame_color": "#a78bfa" } },
        { "type": "set", "settings": { "game_label": "Collectors", "title": "Collectors Vault", "frame_color": "#60a5fa" } }
      ]
    }
  ]
}
{% endschema %}
