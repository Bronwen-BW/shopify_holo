{%- comment -%}
  TCG 商品页
  功能：
  1. 基于 Shopify 官方 {% form 'product', product %}、/cart/add.js 与 routes.cart_checkout_url 实现加购、立即购买与动态结账按钮
  2. 完善主图、缩略图画廊、SKU 专属图联动
  3. 完整展示所有 SKU（含 SKU 缩略图、完整规格名、完整 SKU 编码、价格、库存状态），彻底解决 SKU 显示不全或被截断的问题
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign is_preorder = false -%}
{%- if product.tags contains 'pre' or product.tags contains 'preorder' -%}{%- assign is_preorder = true -%}{%- endif -%}
{%- assign is_single = false -%}
{%- if product.type contains 'Single' or product.tags contains 'single' -%}{%- assign is_single = true -%}{%- endif -%}
{%- assign game_title = product.collections.first.title | default: product.vendor | default: 'TCG' -%}
{%- assign product_form_id = 'tcg-product-form-' | append: section.id -%}

{%- assign main_img_obj = current_variant.featured_image | default: product.featured_image -%}
{%- if main_img_obj != blank -%}
  {%- assign main_img_src = main_img_obj | image_url: width: 1400 -%}
{%- else -%}
  {%- assign main_img_src = 'logo-mark.png' | asset_url -%}
{%- endif -%}

<div class="_page_4xdw3_1" data-tcg-product-section>
  <div class="_wide_4xdw3_6">

    {%- comment %} 面包屑：返回 + Shop / 系列 / 当前产品 {% endcomment -%}
    <nav aria-label="Breadcrumb" class="_breadcrumb_4xdw3_11">
      <a aria-label="Back to products" href="{{ routes.all_products_collection_url }}" class="_crumbBack_4xdw3_69">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
      </a>
      <ol>
        <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
        <li><a href="{{ product.collections.first.url | default: routes.all_products_collection_url }}">{{ game_title }}</a></li>
        <li aria-current="page"><span>{{ product.title }}</span></li>
      </ol>
    </nav>

    <section class="_hero_4xdw3_131 {% if is_single %}{% else %}_sealedHero_4xdw3_1314{% endif %}">

      {%- comment %} ================= 左侧：主图 + 全部媒体与 SKU 缩略图画廊 ================= {% endcomment -%}
      <div class="_mediaPanel_4xdw3_138">
        <div class="_productMedia_4xdw3_145">
          <span aria-hidden="true" class="_floor_4xdw3_183"></span>
          {%- if is_single -%}
            <div class="_interactiveCard_4xdw3_176" data-tilt-card>
              <img
                draggable="false"
                data-main-image
                src="{{ main_img_src }}"
                alt="{{ current_variant.title | default: product.title | escape }}"
                width="1000"
                height="1000"
              >
            </div>
          {%- else -%}
            <img
              draggable="false"
              data-main-image
              src="{{ main_img_src }}"
              alt="{{ current_variant.title | default: product.title | escape }}"
              width="1000"
              height="1000"
            >
          {%- endif -%}
        </div>

        {%- if product.media.size > 0 -%}
          <div class="_thumbs_4xdw3_201 tcg-thumbs-wrap" role="list" aria-label="Product media thumbnails">
            {%- for media in product.media -%}
              {%- assign thumb_src = media.preview_image | image_url: width: 240 -%}
              {%- assign full_src = media.preview_image | image_url: width: 1400 -%}
              {%- assign is_active_thumb = false -%}
              {%- if current_variant.featured_media and current_variant.featured_media.id == media.id -%}
                {%- assign is_active_thumb = true -%}
              {%- elsif current_variant.featured_media == blank and forloop.first -%}
                {%- assign is_active_thumb = true -%}
              {%- endif -%}
              <button
                type="button"
                class="_thumb_4xdw3_201 {% if is_active_thumb %}_thumbActive_4xdw3_239{% endif %}"
                data-thumb
                data-media-id="{{ media.id }}"
                data-full="{{ full_src }}"
                aria-label="Preview image {{ forloop.index }}"
              >
                <img src="{{ thumb_src }}" alt="{{ media.alt | default: product.title | escape }}" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment %} ================= 右侧：商品信息 + 完整 SKU 选择器 + Shopify 官方购买表单 ================= {% endcomment -%}
      <aside class="_purchase_4xdw3_269">
        <header class="_purchaseHeader_4xdw3_280">
          <div class="_productKicker_4xdw3_286">
            <a href="{{ product.collections.first.url | default: routes.all_products_collection_url }}" class="_gameLink_4xdw3_346">{{ game_title }}</a>
            {%- if product.type != blank -%}
              <a href="{{ routes.search_url }}?q={{ product.type | url_encode }}">{{ product.type }}</a>
            {%- endif -%}
            <span class="tcg-kicker-sku" data-kicker-sku-wrap {% if current_variant.sku == blank %}hidden{% endif %}>
              SKU: <strong data-variant-sku>{{ current_variant.sku | default: '—' }}</strong>
            </span>
          </div>

          <div class="_titleRow_4xdw3_379">
            <h1>{{ product.title }}</h1>
            <button type="button" class="_saveButton_4xdw3_395" data-wishlist aria-label="Save {{ product.title | escape }} to wishlist" aria-pressed="false">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"></path></svg>
            </button>
          </div>
        </header>

        {%- comment %} 价格 + 库存状态（随所选 SKU 实时更新） {% endcomment -%}
        <div class="_priceStockRow_4xdw3_473">
          <div class="_priceBlock_4xdw3_481">
            <del data-variant-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>
              {{ current_variant.compare_at_price | money }}
            </del>
            <p class="_price_4xdw3_473" data-variant-price>{{ current_variant.price | money }}</p>
          </div>

          <div
            class="_stockLine_4xdw3_501 {% if is_preorder %}_stockLinePreorder_4xdw3_520{% elsif current_variant.available == false %}_stockLineOut_4xdw3_525{% endif %}"
            data-variant-stock-badge
          >
            <span></span>
            <strong data-variant-stock-text>
              {%- if is_preorder -%}
                Pre-order
              {%- elsif current_variant.available -%}
                In stock{% if current_variant.inventory_management and current_variant.inventory_quantity > 0 %} ({{ current_variant.inventory_quantity }}){% endif %}
              {%- else -%}
                Out of stock
              {%- endif -%}
            </strong>
          </div>
        </div>

        {%- comment %} 预售倒计时 {% endcomment -%}
        {%- if is_preorder and product.metafields.custom.release_date != blank -%}
          <p class="_preorderNotice_4xdw3_530">Releases in <span data-countdown="{{ product.metafields.custom.release_date | date: '%Y-%m-%dT%H:%M:%S' }}"><strong>–</strong></span></p>
        {%- endif -%}

        {%- comment %} 简短描述 {% endcomment -%}
        {%- if product.description != blank -%}
          <p class="_description_4xdw3_536">{{ product.description | strip_html | truncate: 280 }}</p>
        {%- endif -%}

        {%- comment %} ================= 完整 SKU / 多规格选择区（图文卡片 + 属性组 + 下拉同步，无截断） ================= {% endcomment -%}
        <div class="_variantPicker_4xdw3_548 tcg-sku-section" data-sku-picker>
          <div class="tcg-sku-header">
            <span class="tcg-sku-label">
              {%- if product.variants.size > 1 -%}
                Select SKU / Variant ({{ product.variants.size }} available)
              {%- else -%}
                Selected Specification / SKU
              {%- endif -%}
            </span>
            <span class="tcg-sku-current-code">
              SKU: <strong data-variant-sku>{{ current_variant.sku | default: 'Standard' }}</strong>
            </span>
          </div>

          {%- comment %} 多维属性按钮组（当商品定义了非默认属性时显示） {% endcomment -%}
          {%- unless product.has_only_default_variant -%}
            {%- if product.options_with_values.size > 1 -%}
              <div class="tcg-option-groups" data-option-groups>
                {%- for option in product.options_with_values -%}
                  <div class="tcg-option-group" data-option-index="{{ forloop.index0 }}">
                    <span class="tcg-option-name">{{ option.name }}: <strong data-option-selected-val>{{ option.selected_value }}</strong></span>
                    <div class="tcg-option-values">
                      {%- for value in option.values -%}
                        <button
                          type="button"
                          class="tcg-option-pill {% if option.selected_value == value %}is-selected{% endif %}"
                          data-option-btn
                          data-option-position="{{ option.position }}"
                          data-option-value="{{ value | escape }}"
                        >
                          {{ value }}
                        </button>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endunless -%}

          {%- comment %} 可视化 SKU 图文卡片网格（完整显示每个 SKU 的专属图、完整标题、SKU 编码、价格与库存，绝不截断） {% endcomment -%}
          {%- if section.settings.show_sku_grid != false -%}
            <div class="tcg-sku-grid" role="radiogroup" aria-label="Product SKUs" data-sku-grid>
              {%- for variant in product.variants -%}
                {%- assign v_img_obj = variant.featured_image | default: product.featured_image -%}
                {%- if v_img_obj != blank -%}
                  {%- assign v_thumb = v_img_obj | image_url: width: 160 -%}
                  {%- assign v_full = v_img_obj | image_url: width: 1400 -%}
                {%- else -%}
                  {%- assign v_thumb = 'logo-mark.png' | asset_url -%}
                  {%- assign v_full = 'logo-mark.png' | asset_url -%}
                {%- endif -%}
                {%- assign v_title = variant.title -%}
                {%- if v_title == 'Default Title' -%}
                  {%- assign v_title = product.title -%}
                {%- endif -%}

                <button
                  type="button"
                  role="radio"
                  aria-checked="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                  class="tcg-sku-card {% if variant.id == current_variant.id %}is-active{% endif %} {% unless variant.available %}is-soldout{% endunless %}"
                  data-sku-card
                  data-variant-id="{{ variant.id }}"
                  data-variant-title="{{ v_title | escape }}"
                  data-variant-sku="{{ variant.sku | default: '—' | escape }}"
                  data-variant-price="{{ variant.price | money | escape }}"
                  data-variant-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                  data-variant-available="{{ variant.available }}"
                  data-variant-qty="{{ variant.inventory_quantity | default: 0 }}"
                  data-variant-tracked="{{ variant.inventory_management | escape }}"
                  data-variant-image="{{ v_full }}"
                  data-variant-media-id="{{ variant.featured_media.id }}"
                >
                  <span class="tcg-sku-card-thumb">
                    <img src="{{ v_thumb }}" alt="{{ v_title | escape }}" loading="lazy">
                  </span>
                  <span class="tcg-sku-card-body">
                    <strong class="tcg-sku-card-title">{{ v_title }}</strong>
                    <span class="tcg-sku-card-meta">
                      {%- if variant.sku != blank -%}
                        <code class="tcg-sku-code">{{ variant.sku }}</code>
                      {%- endif -%}
                      <span class="tcg-sku-price">{{ variant.price | money }}</span>
                      {%- if variant.available -%}
                        <span class="tcg-sku-stock is-in">In stock</span>
                      {%- else -%}
                        <span class="tcg-sku-stock is-out">Sold out</span>
                      {%- endif -%}
                    </span>
                  </span>
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- comment %} 原生下拉选择器（超过 1 个变体时辅助快速检索，并与上方卡片双向同步） {% endcomment -%}
          {%- if product.variants.size > 1 -%}
            <label class="tcg-sku-select-wrap">
              <span>Quick SKU Switcher</span>
              <select data-variant-select aria-label="Select SKU">
                {%- for variant in product.variants -%}
                  <option
                    value="{{ variant.id }}"
                    {% if variant.id == current_variant.id %}selected{% endif %}
                  >
                    {{ variant.title }}{% if variant.sku != blank %} ({{ variant.sku }}){% endif %} — {{ variant.price | money }}{% unless variant.available %} [Sold out]{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
            </label>
          {%- endif -%}

          {%- comment %} 当前选中 SKU 汇总栏 {% endcomment -%}
          <div class="_variantSummary_4xdw3_598" data-variant-summary>
            <span>Selected: <strong data-variant-title>{% if current_variant.title != 'Default Title' %}{{ current_variant.title }}{% else %}{{ product.title }}{% endif %}</strong></span>
            <span>SKU: <strong data-variant-sku>{{ current_variant.sku | default: '—' }}</strong></span>
            <span class="{% if current_variant.available %}_variantIn_4xdw3_615{% else %}_variantOut_4xdw3_619{% endif %}" data-variant-summary-stock>
              {%- if current_variant.available -%}Ready to ship{%- else -%}Currently unavailable{%- endif -%}
            </span>
          </div>
        </div>

        {%- comment %} ================= Shopify 官方商品购买表单 ================= {% endcomment -%}
        {%- if product != blank -%}
          {%- form 'product', product, id: product_form_id, class: 'tcg-product-form', data-product-form: '' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

            <div class="_buyArea_4xdw3_623">
              <div aria-label="Quantity" class="_quantity_4xdw3_629" data-quantity>
                <button type="button" aria-label="Decrease quantity" data-qty-minus disabled>−</button>
                <input
                  type="number"
                  name="quantity"
                  value="1"
                  min="1"
                  max="999"
                  aria-label="Quantity"
                  class="tcg-qty-input"
                  data-qty-input
                >
                <span aria-live="polite" data-qty-value hidden>1</span>
                <button type="button" aria-label="Increase quantity" data-qty-plus>+</button>
              </div>

              <button
                type="submit"
                name="add"
                class="_primaryButton_4xdw3_673"
                data-product-add
                data-variant="{{ current_variant.id }}"
                data-preorder="{{ is_preorder }}"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span data-product-add-text>
                  {%- if current_variant.available == false -%}
                    Sold out
                  {%- elsif is_preorder -%}
                    Pre-order
                  {%- else -%}
                    Add to cart
                  {%- endif -%}
                </span>
              </button>
            </div>

            {%- comment %} 立即购买（Shopify 官方 /checkout 直达） + Shopify 动态加速结账按钮 {% endcomment -%}
            <div class="tcg-buy-actions-row">
              {%- if section.settings.show_buy_now != false -%}
                <button
                  type="button"
                  class="tcg-buy-now-btn"
                  data-buy-now
                  data-variant="{{ current_variant.id }}"
                  data-checkout-url="{{ routes.cart_checkout_url }}"
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
                  <span>Buy it now</span>
                </button>
              {%- endif -%}

              {%- if section.settings.show_dynamic_checkout != false -%}
                <div class="tcg-shopify-payment-btn">
                  {{ form | payment_button }}
                </div>
              {%- endif -%}
            </div>
          {%- endform -%}
        {%- else -%}
          <div class="_buyArea_4xdw3_623">
            <button type="button" class="_primaryButton_4xdw3_673" disabled>Unavailable</button>
          </div>
        {%- endif -%}

        {%- comment %} 加购成功反馈横幅（提供官方购物车与官方结账直达入口） {% endcomment -%}
        <div class="_addedNotice_4xdw3_750" data-added-notice hidden>
          <span class="_addedCheck_4xdw3_769" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
          </span>
          <span class="_addedText_4xdw3_784">Added to cart</span>
          <div class="_addedActions_4xdw3_791">
            <a href="{{ routes.cart_url }}" class="_viewCart_4xdw3_797">
              <span>View cart</span>
              <span class="_viewCartCount_4xdw3_852" data-added-cart-count>{{ cart.item_count }}</span>
            </a>
            <a href="{{ routes.cart_checkout_url }}" class="_checkoutNow_4xdw3_864">Checkout now</a>
          </div>
        </div>

        {%- comment %} 底部信息：品相 / 语言 / 发货 {% endcomment -%}
        <div class="_purchaseFoot_4xdw3_936">
          <div>
            <span>Condition</span>
            <strong>{% if section.settings.default_condition != blank %}{{ section.settings.default_condition }}{% elsif is_single %}Near Mint{% else %}Factory Sealed{% endif %}</strong>
          </div>
          <div>
            <span>Language</span>
            <strong>{{ section.settings.default_language | default: 'English / Japanese' }}</strong>
          </div>
          <div>
            <span>Dispatch</span>
            <strong>{{ section.settings.dispatch_time | default: 'Within 1 business day' }}</strong>
          </div>
        </div>
      </aside>
    </section>

    {%- comment %} 详情区：About + 规格表 {% endcomment -%}
    <section id="product-story" class="_detailsSection_4xdw3_1140">
      <div class="_detailsIntro_4xdw3_1148">
        <h2>{% if is_single %}About this card{% else %}About this product{% endif %}</h2>
        <div class="tcg-rte">
          {%- if product.description != blank -%}
            {{ product.description }}
          {%- else -%}
            <p>{{ product.title }} — condition checked and stored in a smoke-free, climate-stable room until dispatch.</p>
          {%- endif -%}
        </div>
      </div>

      <dl class="_specifications_4xdw3_1149">
        <div><dt>Game / Brand</dt><dd>{{ game_title }}</dd></div>
        <div><dt>Category</dt><dd>{{ product.type | default: 'Trading Cards' }}</dd></div>
        <div><dt>SKU Code</dt><dd data-variant-sku>{{ current_variant.sku | default: '—' }}</dd></div>
        <div><dt>Selected Variant</dt><dd data-variant-title>{% if current_variant.title != 'Default Title' %}{{ current_variant.title }}{% else %}Standard{% endif %}</dd></div>
        <div><dt>Total SKUs</dt><dd>{{ product.variants.size }}</dd></div>
        <div><dt>Condition</dt><dd>{% if section.settings.default_condition != blank %}{{ section.settings.default_condition }}{% elsif is_single %}Near Mint{% else %}Factory Sealed{% endif %}</dd></div>
      </dl>
    </section>

    {%- comment %} 服务带（4 项保障信息） {% endcomment -%}
    <section aria-label="Service information" class="_serviceBand_4xdw3_1240">
      <div class="_serviceItem_4xdw3_1250">
        <span class="_serviceIcon_4xdw3_1269"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 5 6v5c0 4.6 2.8 8.1 7 10 4.2-1.9 7-5.4 7-10V6l-7-3Z"></path><path d="m9 12 2 2 4-4"></path></svg></span>
        <div><h3>Condition checked</h3><p>Inspected in clear light before listing.</p></div>
      </div>
      <div class="_serviceItem_4xdw3_1250">
        <span class="_serviceIcon_4xdw3_1269"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m4 7 8-4 8 4-8 4-8-4Z"></path><path d="m4 7 8 4 8-4v10l-8 4-8-4V7Z"></path><path d="M12 11v10"></path></svg></span>
        <div><h3>Protected packing</h3><p>Sleeved, rigid, and water resistant.</p></div>
      </div>
      <div class="_serviceItem_4xdw3_1250">
        <span class="_serviceIcon_4xdw3_1269"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"></path><circle cx="7" cy="18" r="1.5"></circle><circle cx="18" cy="18" r="1.5"></circle></svg></span>
        <div><h3>Tracked delivery</h3><p>Fast dispatch with full tracking updates.</p></div>
      </div>
      <div class="_serviceItem_4xdw3_1250">
        <span class="_serviceIcon_4xdw3_1269"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 8V4m0 0h4M4 4l4 4"></path><path d="M5.5 15a8 8 0 1 0 .3-6"></path></svg></span>
        <div><h3>14-day returns</h3><p>Simple returns under consumer protection rules.</p></div>
      </div>
    </section>
  </div>

  {%- comment %} 相关推荐：同集合其他产品 {% endcomment -%}
  {%- if section.settings.show_related_products != false and product.collections.first.products.size > 1 -%}
    <div class="_related_4xdw3_1284">
      <section class="_section_36e53_1">
        <div class="_wide_36e53_5">
          <header class="_header_36e53_10">
            <div>
              <h2>More from {{ game_title }}</h2>
              <p>In stock now, starting with the same collection.</p>
            </div>
            <a href="{{ product.collections.first.url }}" class="_viewAll_36e53_33">View all</a>
          </header>
          <div class="_grid_36e53_53">
            {%- assign shown = 0 -%}
            {%- for item in product.collections.first.products -%}
              {%- if item.id != product.id and shown < 4 -%}
                {% render 'tcg-product-card', product: item %}
                {%- assign shown = shown | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </section>
    </div>
  {%- endif -%}

  {%- comment %} 变体 JSON 数据供前端无刷新切换 SKU 图、价格、库存与 URL 参数 {% endcomment -%}
  <script type="application/json" data-product-variants-json>
    [
      {%- for variant in product.variants -%}
        {%- assign v_img = variant.featured_image | default: product.featured_image -%}
        {
          "id": {{ variant.id | json }},
          "title": {{ variant.title | json }},
          "sku": {{ variant.sku | default: '' | json }},
          "barcode": {{ variant.barcode | default: '' | json }},
          "available": {{ variant.available | json }},
          "inventory_quantity": {{ variant.inventory_quantity | default: 0 | json }},
          "inventory_management": {{ variant.inventory_management | default: '' | json }},
          "price": {{ variant.price | json }},
          "price_formatted": {{ variant.price | money | json }},
          "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
          "compare_at_price_formatted": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}""{% endif %},
          "options": {{ variant.options | json }},
          "featured_media_id": {{ variant.featured_media.id | default: null | json }},
          "featured_image_url": {% if v_img != blank %}{{ v_img | image_url: width: 1400 | json }}{% else %}{{ 'logo-mark.png' | asset_url | json }}{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</div>

