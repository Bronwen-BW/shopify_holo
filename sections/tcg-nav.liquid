{%- comment -%}
  TCG 顶部导航：每个导航项都是一个可编辑区块。
  在主题编辑器中可新增、删除、排序、查看并编辑导航项，以及配置黑夜/白天模式切换按钮。
{%- endcomment -%}
{% render 'tcg-header', section: section %}

{% schema %}
{
  "name": "TCG 导航",
  "tag": "section",
  "class": "tcg-nav-section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "brand_prefix",
      "label": "品牌主名称",
      "default": "TCG"
    },
    {
      "type": "text",
      "id": "brand_accent",
      "label": "品牌高亮后缀",
      "default": "Haven"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "搜索框提示文字",
      "default": "Search cards, sets, sealed…"
    },
    {
      "type": "checkbox",
      "id": "enable_theme_toggle",
      "label": "显示黑夜/白天模式切换图标按钮",
      "default": true
    },
    {
      "type": "select",
      "id": "default_theme_mode",
      "label": "默认主题模式",
      "default": "dark",
      "options": [
        { "value": "dark", "label": "黑夜模式 (Dark)" },
        { "value": "light", "label": "白天模式 (Light)" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "nav_item",
      "name": "导航项 / 自定义标签",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "标签名称",
          "default": "Home"
        },
        {
          "type": "url",
          "id": "url",
          "label": "跳转链接"
        },
        {
          "type": "number",
          "id": "sort_order",
          "label": "排序序号 (越小越靠前，0 表示按列表默认顺序)",
          "default": 0
        },
        {
          "type": "checkbox",
          "id": "active",
          "label": "始终高亮（当前页也会自动高亮）",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "在新窗口打开链接",
          "default": false
        }
      ]
    },
    {
      "type": "custom_tab",
      "name": "自定义标签",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "标签名称",
          "default": "Custom Tab"
        },
        {
          "type": "url",
          "id": "url",
          "label": "跳转链接"
        },
        {
          "type": "number",
          "id": "sort_order",
          "label": "排序序号 (越小越靠前，0 表示按列表默认顺序)",
          "default": 0
        },
        {
          "type": "checkbox",
          "id": "active",
          "label": "始终高亮（当前页也会自动高亮）",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "在新窗口打开链接",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TCG 导航",
      "blocks": [
        {
          "type": "nav_item",
          "settings": {
            "label": "Home",
            "url": "/",
            "active": true
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "Shop",
            "url": "/collections/all"
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "Games",
            "url": "/collections"
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "About",
            "url": "/pages/about"
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "Contact",
            "url": "/pages/contact"
          }
        }
      ]
    }
  ]
}
{% endschema %}
