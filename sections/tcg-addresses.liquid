{%- comment -%}
  TCG 客户地址管理页（使用 Shopify 官方 {% form 'customer_address' %} 接口）
{%- endcomment -%}

<div class="_page_4xdw3_1" data-tcg-addresses-section>
  <div class="_wide_4xdw3_6">
    <header class="_header_1z0wo_6">
      <div>
        <a href="{{ routes.account_url }}" class="_back_1fncu_49">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>Back to account
        </a>
        <h1 class="_heading_1z0wo_14" style="margin-top:.4rem;">{{ section.settings.heading | default: 'Your Shipping Addresses' }}</h1>
      </div>
    </header>

    <div class="tcg-account-grid">
      {%- comment %} 左侧：已有地址列表 {% endcomment -%}
      <section class="tcg-card-panel">
        <h2>Saved Addresses ({{ customer.addresses_count | default: 0 }})</h2>
        {%- paginate customer.addresses by 10 -%}
          {%- if customer.addresses.size > 0 -%}
            <div class="tcg-address-grid">
              {%- for address in customer.addresses -%}
                <div class="tcg-address-card">
                  {%- if address == customer.default_address -%}
                    <span class="tcg-badge-pill">Default</span>
                  {%- endif -%}
                  <div class="tcg-address-box">{{ address | format_address }}</div>
                  <div class="tcg-address-actions">
                    <form method="post" action="{{ address.url }}">
                      <input type="hidden" name="_method" value="delete">
                      <button type="submit" class="tcg-btn-ghost">Delete</button>
                    </form>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- else -%}
            <p class="tcg-muted-text" style="margin-top:1rem;">You have no saved addresses yet. Add your first address on the right.</p>
          {%- endif -%}
        {%- endpaginate -%}
      </section>

      {%- comment %} 右侧：新增地址官方表单 {% endcomment -%}
      <aside class="tcg-card-panel">
        <h2>Add a New Address</h2>
        {%- form 'customer_address', customer.new_address, class: 'tcg-auth-form' -%}
          <div class="tcg-form-grid-2">
            <div class="tcg-form-row">
              <label for="AddressFirstNameNew" class="tcg-field-label">First name</label>
              <input type="text" id="AddressFirstNameNew" name="address[first_name]" value="{{ form.first_name }}" class="tcg-input" autocomplete="given-name">
            </div>
            <div class="tcg-form-row">
              <label for="AddressLastNameNew" class="tcg-field-label">Last name</label>
              <input type="text" id="AddressLastNameNew" name="address[last_name]" value="{{ form.last_name }}" class="tcg-input" autocomplete="family-name">
            </div>
          </div>

          <div class="tcg-form-row">
            <label for="AddressAddress1New" class="tcg-field-label">Address line 1</label>
            <input type="text" id="AddressAddress1New" name="address[address1]" value="{{ form.address1 }}" class="tcg-input" autocomplete="address-line1" required>
          </div>

          <div class="tcg-form-row">
            <label for="AddressAddress2New" class="tcg-field-label">Apartment, suite, etc.</label>
            <input type="text" id="AddressAddress2New" name="address[address2]" value="{{ form.address2 }}" class="tcg-input" autocomplete="address-line2">
          </div>

          <div class="tcg-form-grid-2">
            <div class="tcg-form-row">
              <label for="AddressCityNew" class="tcg-field-label">City</label>
              <input type="text" id="AddressCityNew" name="address[city]" value="{{ form.city }}" class="tcg-input" autocomplete="address-level2" required>
            </div>
            <div class="tcg-form-row">
              <label for="AddressZipNew" class="tcg-field-label">Postal / ZIP code</label>
              <input type="text" id="AddressZipNew" name="address[zip]" value="{{ form.zip }}" class="tcg-input" autocomplete="postal-code" required>
            </div>
          </div>

          <div class="tcg-form-row">
            <label for="AddressCountryNew" class="tcg-field-label">Country / Region</label>
            <select id="AddressCountryNew" name="address[country]" data-default="{{ form.country }}" class="tcg-input" autocomplete="country">
              {{ all_country_option_tags }}
            </select>
          </div>

          <div class="tcg-form-row">
            <label for="AddressPhoneNew" class="tcg-field-label">Phone</label>
            <input type="tel" id="AddressPhoneNew" name="address[phone]" value="{{ form.phone }}" class="tcg-input" autocomplete="tel">
          </div>

          <label class="tcg-checkbox-row">
            {{ form.set_as_default_checkbox }}
            <span>Set as default shipping address</span>
          </label>

          <button type="submit" class="_primaryButton_4xdw3_673" style="width:100%;margin-top:.75rem;">Save address</button>
        {%- endform -%}
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TCG 地址管理",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Your Shipping Addresses"
    }
  ],
  "presets": [
    {
      "name": "TCG 地址管理"
    }
  ]
}
{% endschema %}
