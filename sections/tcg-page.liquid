{%- comment -%}
  TCG 通用内容页（templates/page.json）
  支持按页面 handle 智能适配 About us / Contact / Shipping & returns / Policy 完整 TCG 主题布局，同时兼容任意自定义富文本页面
{%- endcomment -%}
{%- assign h = page.handle | downcase -%}

<div class="_page_4xdw3_1">
  <div class="_wide_4xdw3_6">

    <nav aria-label="Breadcrumb" class="_breadcrumb_4xdw3_11">
      <a aria-label="Back to home" href="{{ routes.root_url }}" class="_crumbBack_4xdw3_69">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
      </a>
      <ol>
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li aria-current="page"><span>{{ page.title | default: section.settings.default_title | default: 'Information' }}</span></li>
      </ol>
    </nav>

    {%- if h contains 'about' -%}
      {%- comment %} 当访问 /pages/about 且尚未分配 page.about 模板时，同样渲染完整的 TCG About Us 视觉界面 {% endcomment -%}
      <section class="tcg-hero-banner-card">
        <div class="tcg-hero-banner-copy">
          <span class="tcg-eyebrow">About {{ shop.name | default: 'TCGHaven' }}</span>
          <h1 class="_heading_1z0wo_14" style="margin-top:0.35rem;">Built by Collectors, for Collectors.</h1>
          <p class="tcg-lead-text">
            We specialize in authentic singles, factory-sealed booster boxes, and precision-graded collector slabs across Pokémon, Yu-Gi-Oh!, Magic: The Gathering, Disney Lorcana, and more.
          </p>
          <div class="_actions_dtm2o_101" style="margin-top:1.5rem;">
            <a href="{{ routes.all_products_collection_url }}" class="_primaryButton_4xdw3_673" style="flex:none;">Explore the catalog</a>
            <a href="/blogs/news" class="tcg-btn-secondary">Read Collector Journal</a>
            <a href="/pages/contact" class="tcg-btn-ghost">Get in touch</a>
          </div>
        </div>
        <div class="tcg-hero-banner-art">
          <img src="{{ 'card-charizard.png' | asset_url }}" alt="" loading="lazy">
          <img src="{{ 'card-umbreon.png' | asset_url }}" alt="" loading="lazy">
        </div>
      </section>

      <section class="tcg-stats-strip">
        <div class="tcg-stat-box"><strong>100%</strong><span>Authentic &amp; Verified Cards</span></div>
        <div class="tcg-stat-box"><strong>24h</strong><span>Tracked Warehouse Dispatch</span></div>
        <div class="tcg-stat-box"><strong>4-Layer</strong><span>Sleeve + Toploader + Rigid Armor</span></div>
        <div class="tcg-stat-box"><strong>14-Day</strong><span>Collector Return Guarantee</span></div>
      </section>

      {%- if page.content != blank -%}
        <article class="tcg-card-panel tcg-rte" style="margin-top:1.5rem;">
          {{ page.content }}
        </article>
      {%- endif -%}

      <section class="tcg-pillars-grid" style="margin-top:1.5rem;">
        <div class="tcg-card-panel">
          <span class="tcg-badge-pill">01 · Inspection</span>
          <h3 style="margin-top:0.65rem;">Strict Grading &amp; Condition Checks</h3>
          <p class="tcg-muted-text" style="margin-top:.5rem;">Every single card is inspected under 5500K studio lighting for surface, centering, corners, and edges before entering our climate-controlled vault.</p>
        </div>
        <div class="tcg-card-panel">
          <span class="tcg-badge-pill">02 · Provenance</span>
          <h3 style="margin-top:0.65rem;">Factory-Sealed Provenance</h3>
          <p class="tcg-muted-text" style="margin-top:.5rem;">Our booster boxes, Elite Trainer Boxes, and collector gift sets come directly from authorized distribution channels with intact factory wrap.</p>
        </div>
        <div class="tcg-card-panel">
          <span class="tcg-badge-pill">03 · Fulfillment</span>
          <h3 style="margin-top:0.65rem;">Collector-Grade Armor Packaging</h3>
          <p class="tcg-muted-text" style="margin-top:.5rem;">Singles ship in a penny sleeve, rigid toploader, team bag, and bubble mailer. Graded slabs and sealed boxes ship double-boxed with corner protection.</p>
        </div>
      </section>

    {%- else -%}
      <article class="tcg-page-card">
        <header class="tcg-page-card-header">
          <span class="tcg-eyebrow">{{ shop.name | default: 'TCGHaven' }}</span>
          <h1>{{ page.title | default: section.settings.default_title | default: 'Information' }}</h1>
        </header>

        <div class="tcg-rte">
          {%- if page.content != blank -%}
            {{ page.content }}
          {%- elsif h contains 'shipping' or h contains 'return' -%}
            <p>In-stock orders dispatch within 1 business day with full tracking. Singles ship in a penny sleeve, rigid toploader, team bag, and bubble mailer. You have 14 days from delivery to request a return under EU consumer protection rules.</p>
            {%- if shop.shipping_policy.body != blank -%}{{ shop.shipping_policy.body }}{%- endif -%}
            {%- if shop.refund_policy.body != blank -%}{{ shop.refund_policy.body }}{%- endif -%}
          {%- elsif h contains 'policy' or h contains 'privacy' or h contains 'terms' -%}
            {%- if shop.privacy_policy.body != blank -%}{{ shop.privacy_policy.body }}{%- endif -%}
            {%- if shop.terms_of_service.body != blank -%}{{ shop.terms_of_service.body }}{%- endif -%}
          {%- else -%}
            <p>{{ section.settings.empty_text | default: 'This page content can be edited in Shopify Admin → Online Store → Pages.' }}</p>
          {%- endif -%}
        </div>

        {%- if h contains 'contact' -%}
          <div style="margin-top:2rem;">
            {%- form 'contact', id: 'PageContactForm', class: 'tcg-auth-form' -%}
              {%- if form.posted_successfully? -%}
                <div class="tcg-alert tcg-alert-success" role="status">Thank you for your message! We will get back to you shortly.</div>
              {%- elsif form.errors -%}
                <div class="tcg-alert tcg-alert-error" role="alert">{{ form.errors | default_errors }}</div>
              {%- endif -%}
              <div class="tcg-form-grid-2">
                <div class="tcg-form-row">
                  <label class="tcg-field-label" for="PageContact-name">Name</label>
                  <input type="text" id="PageContact-name" name="contact[name]" class="tcg-input" value="{{ form.name }}">
                </div>
                <div class="tcg-form-row">
                  <label class="tcg-field-label" for="PageContact-email">Email *</label>
                  <input type="email" id="PageContact-email" name="contact[email]" class="tcg-input" value="{{ form.email }}" required>
                </div>
              </div>
              <div class="tcg-form-row">
                <label class="tcg-field-label" for="PageContact-body">Message *</label>
                <textarea id="PageContact-body" name="contact[body]" rows="5" class="tcg-textarea" required>{{ form.body }}</textarea>
              </div>
              <button type="submit" class="_primaryButton_4xdw3_673">Send message</button>
            {%- endform -%}
          </div>
        {%- endif -%}
      </article>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "TCG 内容页",
  "settings": [
    {
      "type": "text",
      "id": "default_title",
      "label": "默认标题（无页面标题时使用）",
      "default": "Information"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "页面内容为空时的默认说明",
      "default": "This page content can be edited in Shopify Admin → Online Store → Pages."
    }
  ],
  "presets": [
    {
      "name": "TCG 内容页"
    }
  ]
}
{% endschema %}
