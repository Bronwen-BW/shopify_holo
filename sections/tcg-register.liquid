{%- comment -%}
  TCG 客户注册页（使用 Shopify 官方 {% form 'create_customer' %} 接口）
{%- endcomment -%}

<div class="_page_4xdw3_1" data-tcg-register-section>
  <div class="_wide_4xdw3_6">
    <div class="tcg-auth-shell">
      <section class="tcg-auth-card">
        <header class="tcg-auth-header">
          <span class="tcg-eyebrow">Join the Community</span>
          <h1>{{ section.settings.heading | default: 'Create your collector account' }}</h1>
          <p>{{ section.settings.subheading | default: 'Save your delivery addresses, track graded & sealed shipments, and check out faster.' }}</p>
        </header>

        {%- form 'create_customer', novalidate: 'novalidate', class: 'tcg-auth-form' -%}
          {%- if form.errors -%}
            <div class="tcg-alert tcg-alert-error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="tcg-form-grid-2">
            <div class="tcg-form-row">
              <label for="RegisterForm-FirstName" class="tcg-field-label">First name</label>
              <input
                type="text"
                name="customer[first_name]"
                id="RegisterForm-FirstName"
                class="tcg-input"
                {% if form.first_name %}value="{{ form.first_name }}"{% endif %}
                autocomplete="given-name"
                placeholder="Ash"
              >
            </div>

            <div class="tcg-form-row">
              <label for="RegisterForm-LastName" class="tcg-field-label">Last name</label>
              <input
                type="text"
                name="customer[last_name]"
                id="RegisterForm-LastName"
                class="tcg-input"
                {% if form.last_name %}value="{{ form.last_name }}"{% endif %}
                autocomplete="family-name"
                placeholder="Ketchum"
              >
            </div>
          </div>

          <div class="tcg-form-row">
            <label for="RegisterForm-email" class="tcg-field-label">Email address *</label>
            <input
              type="email"
              name="customer[email]"
              id="RegisterForm-email"
              class="tcg-input"
              {% if form.email %}value="{{ form.email }}"{% endif %}
              spellcheck="false"
              autocapitalize="off"
              autocomplete="email"
              placeholder="collector@example.com"
              required
            >
          </div>

          <div class="tcg-form-row">
            <label for="RegisterForm-password" class="tcg-field-label">Password *</label>
            <input
              type="password"
              name="customer[password]"
              id="RegisterForm-password"
              class="tcg-input"
              autocomplete="new-password"
              placeholder="At least 5 characters"
              required
            >
          </div>

          <div class="tcg-auth-actions">
            <button type="submit" class="_primaryButton_4xdw3_673" style="width:100%;">
              {{ section.settings.submit_label | default: 'Create account' }}
            </button>
          </div>
        {%- endform -%}

        <footer class="tcg-auth-footer">
          <p>Already have an account? <a href="{{ routes.account_login_url }}" class="tcg-link-accent">Sign in →</a></p>
        </footer>
      </section>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TCG 注册页",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "注册标题",
      "default": "Create your collector account"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "注册副标题",
      "default": "Save your delivery addresses, track graded & sealed shipments, and check out faster."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "注册按钮文字",
      "default": "Create account"
    }
  ],
  "presets": [
    {
      "name": "TCG 注册页"
    }
  ]
}
{% endschema %}
