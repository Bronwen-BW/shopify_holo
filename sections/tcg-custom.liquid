{%- comment -%}
  TCG 定制商品列表页 Section（sections/tcg-custom.liquid）
  支持：
  1. 无限制数量的定制商品（未限制 max_blocks，可在主题编辑器无限新增 custom_product 区块，同时支持绑定集合无限分页/动态加载）
  2. 商品卡片样式与模板现有 _card_36e53_65 100% 保持一致
  3. 点击商品卡片直接跳转到对应定制链接（如 /products/custom-your-premium-card-extended-art-display-cases-collection?custom=1）
{%- endcomment -%}

{% render 'tcg-custom-catalog-view', section: section %}

{% schema %}
{
  "name": "TCG 定制商品列表页",
  "tag": "section",
  "class": "tcg-custom-catalog-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "页面主标题",
      "default": "Custom Card Display Cases & Extended Art"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "顶部引导小标题",
      "default": "BESPOKE EXTENDED ARTWORK · UV-PROTECTED ACRYLIC & ANODIZED METAL ARMOR"
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "页面顶部介绍文案",
      "default": "Turn your favorite Pokémon, One Piece, Yu-Gi-Oh!, or Magic card into a museum-grade centerpiece. Choose any custom product below, select your SKU style & frame color, enter your email, upload multiple card photos, and add up to 10,000 characters of customization notes."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero 精选展示图（留空使用默认定制展示盒图）"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "绑定定制商品集合（支持无限商品自动同步）"
    },
    {
      "type": "checkbox",
      "id": "auto_include_custom_tagged",
      "label": "自动合并店铺内带有 custom/定制 标签的商品",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "单批加载商品数（超出支持无限加载）",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "text",
      "id": "grid_heading",
      "label": "列表区标题",
      "default": "Custom Products Catalog"
    },
    {
      "type": "text",
      "id": "grid_subheading",
      "label": "列表区副标题",
      "default": "Click any product below to open its dedicated customization page."
    }
  ],
  "blocks": [
    {
      "type": "custom_product",
      "name": "定制商品项 (支持无限新增)",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "关联 Shopify 商品（可选，优先自动拉取）"
        },
        {
          "type": "text",
          "id": "title",
          "label": "商品名称",
          "default": "Custom Your Premium Card Extended Art Display Cases Collection"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "副标题 / 规格说明",
          "default": "Extended Art Display Case · 4 Styles × 15 Colors"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "左上角徽章 (如 60 SKUs / Custom)",
          "default": "60 SKUs"
        },
        {
          "type": "text",
          "id": "price",
          "label": "展示价格",
          "default": "$35.99"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "划线原价",
          "default": "$36.00"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "商品主图（上传选择器）"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "商品主图外链 URL（未上传图片时使用）",
          "default": "https://animeholder.com/cdn/shop/files/CardRequestYourCardPSASlabAcrylicCaseFrontSBlack.jpg?v=1780547492&width=800"
        },
        {
          "type": "text",
          "id": "category",
          "label": "分类筛选标识 (psa / magnetic / screw / metal / all)",
          "default": "psa"
        },
        {
          "type": "text",
          "id": "handle_slug",
          "label": "定制商品唯一标识 (Handle)",
          "default": "custom-your-premium-card-extended-art-display-cases-collection"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "自定义跳转定制链接（留空自动生成 /products/<handle>?custom=1）"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TCG 定制商品列表页"
    }
  ]
}
{% endschema %}
