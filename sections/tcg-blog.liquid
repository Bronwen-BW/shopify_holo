{%- comment -%}
  TCG 文章列表页（对接 Shopify 官方 blog.articles 接口，同时内置默认文章与页内/跨页文章详情切换，确保点击任意文章列表项都会切换到对应的文章页面）
{%- endcomment -%}

<div class="_page_4xdw3_1" data-tcg-blog-section>
  <div class="_wide_4xdw3_6">

    {%- comment %} ================= 1. 文章列表主视图 ================= {% endcomment -%}
    <div data-blog-list-view>
      <nav aria-label="Breadcrumb" class="_breadcrumb_4xdw3_11">
        <a aria-label="Back to home" href="{{ routes.root_url }}" class="_crumbBack_4xdw3_69">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
        </a>
        <ol>
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li aria-current="page"><span>{{ blog.title | default: section.settings.heading | default: 'Collector Journal & Set Guides' }}</span></li>
        </ol>
      </nav>

      <section class="tcg-hero-banner-card" style="margin-bottom:1.5rem;">
        <div class="tcg-hero-banner-copy">
          <span class="tcg-eyebrow">{{ section.settings.eyebrow | default: 'Collector Journal' }}</span>
          <h1 class="_heading_1z0wo_14" style="margin-top:0.35rem;">{{ blog.title | default: section.settings.heading | default: 'News & Set Guides' }}</h1>
          <p class="tcg-lead-text">
            {{ section.settings.subheading | default: 'In-depth set checklists, PSA & BGS grading guides, pull-rate breakdowns, and vault packaging insights from our collector team.' }}
          </p>
        </div>
        <div class="tcg-hero-banner-art" aria-hidden="true">
          <img src="{{ 'card-charizard.png' | asset_url }}" alt="" loading="lazy">
          <img src="{{ 'card-palkia.png' | asset_url }}" alt="" loading="lazy">
        </div>
      </section>

      {%- paginate blog.articles by 9 -%}
        {%- if blog.articles.size > 0 -%}
          <div class="tcg-pillars-grid tcg-blog-grid">
            {%- for article in blog.articles -%}
              {%- if article.image -%}
                {%- assign art_img = article.image | image_url: width: 800 -%}
              {%- else -%}
                {%- assign art_img = 'card-charizard.png' | asset_url -%}
              {%- endif -%}
              <a
                href="{{ article.url }}"
                class="tcg-card-panel tcg-blog-card"
                data-blog-article-card
                data-article-handle="{{ article.handle | escape }}"
                data-article-url="{{ article.url }}"
              >
                <div class="tcg-blog-thumb">
                  <img src="{{ art_img }}" alt="{{ article.title | escape }}" loading="lazy">
                  <span class="tcg-badge-pill tcg-blog-badge">{{ article.tags.first | default: 'Guide' }}</span>
                </div>
                <div class="tcg-blog-card-body">
                  <div class="tcg-blog-meta">
                    <span class="tcg-eyebrow">{{ article.published_at | date: '%b %d, %Y' }}</span>
                    {%- if article.author != blank -%}
                      <span class="tcg-blog-author">· {{ article.author }}</span>
                    {%- endif -%}
                  </div>
                  <h3>{{ article.title }}</h3>
                  <p class="tcg-muted-text">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
                  <span class="tcg-blog-readmore">Read full article →</span>
                </div>
              </a>
            {%- endfor -%}
          </div>
        {%- else -%}
          {%- comment %} 当后台尚未发布文章时，展示默认精品 TCG 指南文章卡片，点击可直接切换到对应文章详情页 {% endcomment -%}
          <div class="tcg-pillars-grid tcg-blog-grid">
            <a
              href="?article=scarlet-violet-151-collector-guide"
              class="tcg-card-panel tcg-blog-card"
              data-blog-article-card
              data-article-handle="scarlet-violet-151-collector-guide"
            >
              <div class="tcg-blog-thumb">
                <img src="{{ 'card-charizard.png' | asset_url }}" alt="Scarlet & Violet 151 Complete Collector & Grading Guide" loading="lazy">
                <span class="tcg-badge-pill tcg-blog-badge">Set Guide</span>
              </div>
              <div class="tcg-blog-card-body">
                <div class="tcg-blog-meta">
                  <span class="tcg-eyebrow">Oct 28, 2026</span>
                  <span class="tcg-blog-author">· TCGHaven Vault Team</span>
                </div>
                <h3>Scarlet &amp; Violet 151 Complete Collector &amp; Grading Guide</h3>
                <p class="tcg-muted-text">Everything you need to know about Special Illustration Rares, God Packs, and print quality in Scarlet &amp; Violet 151.</p>
                <span class="tcg-blog-readmore">Read full article →</span>
              </div>
            </a>

            <a
              href="?article=how-we-pack-graded-slabs-and-sealed-boxes"
              class="tcg-card-panel tcg-blog-card"
              data-blog-article-card
              data-article-handle="how-we-pack-graded-slabs-and-sealed-boxes"
            >
              <div class="tcg-blog-thumb">
                <img src="{{ 'card-umbreon.png' | asset_url }}" alt="Inside Our 4-Layer Collector Armor Packaging Standard" loading="lazy">
                <span class="tcg-badge-pill tcg-blog-badge">Vault Standard</span>
              </div>
              <div class="tcg-blog-card-body">
                <div class="tcg-blog-meta">
                  <span class="tcg-eyebrow">Oct 15, 2026</span>
                  <span class="tcg-blog-author">· TCGHaven Fulfillment</span>
                </div>
                <h3>Inside Our 4-Layer Collector Armor Packaging Standard</h3>
                <p class="tcg-muted-text">From acid-free penny sleeves and rigid toploaders to double-walled boxes: see how your cards travel safely.</p>
                <span class="tcg-blog-readmore">Read full article →</span>
              </div>
            </a>

            <a
              href="?article=prismatic-evolutions-preorder-schedule"
              class="tcg-card-panel tcg-blog-card"
              data-blog-article-card
              data-article-handle="prismatic-evolutions-preorder-schedule"
            >
              <div class="tcg-blog-thumb">
                <img src="{{ 'card-palkia.png' | asset_url }}" alt="Prismatic Evolutions Pre-order & Release Day Dispatch Info" loading="lazy">
                <span class="tcg-badge-pill tcg-blog-badge">Release Drop</span>
              </div>
              <div class="tcg-blog-card-body">
                <div class="tcg-blog-meta">
                  <span class="tcg-eyebrow">Nov 02, 2026</span>
                  <span class="tcg-blog-author">· TCGHaven Vault Team</span>
                </div>
                <h3>Prismatic Evolutions Pre-order &amp; Release Day Dispatch Info</h3>
                <p class="tcg-muted-text">Check allocation waves, Elite Trainer Box contents, and guaranteed first-wave dispatch timelines.</p>
                <span class="tcg-blog-readmore">Read full article →</span>
              </div>
            </a>
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="tcg-pagination" aria-label="Blog pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="tcg-page-btn">← Previous</a>{%- endif -%}
            <span class="tcg-page-status">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="tcg-page-btn">Next →</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    </div>

    {%- comment %} ================= 2. 对应文章详情视图（支持页内无刷新切换及 ?article= 直达） ================= {% endcomment -%}
    <div data-blog-article-view hidden>
      <nav aria-label="Breadcrumb" class="_breadcrumb_4xdw3_11">
        <a aria-label="Back to articles" href="{{ blog.url | default: '/blogs/news' }}" class="_crumbBack_4xdw3_69" data-back-to-blog-list>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
        </a>
        <ol>
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="{{ blog.url | default: '/blogs/news' }}" data-back-to-blog-list>{{ blog.title | default: 'Collector Journal' }}</a></li>
          <li aria-current="page"><span data-article-detail-crumb>Article</span></li>
        </ol>
      </nav>

      <article class="tcg-page-card tcg-article-detail-card">
        <header class="tcg-page-card-header">
          <a href="{{ blog.url | default: '/blogs/news' }}" class="_back_1fncu_49" data-back-to-blog-list style="margin-bottom:.85rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>Back to all articles
          </a>
          <div class="tcg-blog-meta" style="margin-bottom:0.4rem;">
            <span class="tcg-badge-pill" data-article-detail-tag>Collector Guide</span>
            <span class="tcg-eyebrow" data-article-detail-meta>Oct 28, 2026 · TCGHaven Vault Team</span>
          </div>
          <h1 data-article-detail-title>Scarlet &amp; Violet 151 Complete Collector &amp; Grading Guide</h1>
        </header>

        <div class="tcg-article-hero-media" data-article-detail-media>
          <img data-article-detail-image src="{{ 'card-charizard.png' | asset_url }}" alt="">
        </div>

        <div class="tcg-rte" data-article-detail-content></div>

        <footer class="tcg-article-footer">
          <a href="{{ blog.url | default: '/blogs/news' }}" class="tcg-btn-secondary" data-back-to-blog-list>← Back to Article List</a>
          <a href="{{ routes.all_products_collection_url }}" class="_primaryButton_4xdw3_673" style="flex:none;">Shop Featured Sets</a>
        </footer>
      </article>
    </div>

    {%- comment %} 注入全部文章 JSON 数据（含后台真实文章与默认精品文章），确保点击任意文章卡片均可切换到对应文章页面 {% endcomment -%}
    <script type="application/json" data-blog-articles-json>
      [
        {%- if blog.articles.size > 0 -%}
          {%- for article in blog.articles -%}
            {
              "handle": {{ article.handle | json }},
              "url": {{ article.url | json }},
              "title": {{ article.title | json }},
              "author": {{ article.author | default: 'TCGHaven Vault Team' | json }},
              "published_at": {{ article.published_at | date: '%B %d, %Y' | json }},
              "tag": {{ article.tags.first | default: 'Collector Guide' | json }},
              "image": {% if article.image %}{{ article.image | image_url: width: 1200 | json }}{% else %}{{ 'card-charizard.png' | asset_url | json }}{% endif %},
              "excerpt": {{ article.excerpt_or_content | strip_html | truncate: 160 | json }},
              "content_html": {{ article.content | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- else -%}
          {
            "handle": "scarlet-violet-151-collector-guide",
            "url": "?article=scarlet-violet-151-collector-guide",
            "title": "Scarlet & Violet 151 Complete Collector & Grading Guide",
            "author": "TCGHaven Vault Team",
            "published_at": "October 28, 2026",
            "tag": "Set Guide",
            "image": {{ 'card-charizard.png' | asset_url | json }},
            "excerpt": "Everything you need to know about Special Illustration Rares, God Packs, and print quality in Scarlet & Violet 151.",
            "content_html": "<p>Scarlet &amp; Violet 151 brings the original Kanto Pokédex (#001 Bulbasaur through #151 Mew) back to the modern Pokémon TCG era with breathtaking Special Illustration Rares (SIR) for Charizard ex, Blastoise ex, Venusaur ex, Alakazam ex, and Zapdos ex.</p><h3>Key Chase Cards &amp; Pull Rates</h3><ul><li><strong>Charizard ex (#199/165 SIR):</strong> Iconic canyon flight artwork by Souichirou Gunjima — the #1 chase card of the expansion.</li><li><strong>Blastoise ex (#200/165 SIR) &amp; Venusaur ex (#198/165 SIR):</strong> Deep ocean and lush botanical full-art illustrations that pair with the evolution lines.</li><li><strong>English vs. Japanese 151 (sv2a):</strong> Japanese boxes feature guaranteed Master Ball reverse holos (1 per booster box), while English Ultra-Premium Collections include exclusive promos.</li></ul><h3>How We Inspect Every Single Card</h3><p>At TCGHaven, every raw single is inspected under 5500K studio lighting for surface print lines, corner whitening, and front/back centering before entering our climate-controlled vault, ensuring accurate Near Mint (NM) or PSA 10 candidate grading.</p>"
          },
          {
            "handle": "how-we-pack-graded-slabs-and-sealed-boxes",
            "url": "?article=how-we-pack-graded-slabs-and-sealed-boxes",
            "title": "Inside Our 4-Layer Collector Armor Packaging Standard",
            "author": "TCGHaven Fulfillment",
            "published_at": "October 15, 2026",
            "tag": "Vault Standard",
            "image": {{ 'card-umbreon.png' | asset_url | json }},
            "excerpt": "From acid-free penny sleeves and rigid toploaders to double-walled boxes: see how your cards travel safely.",
            "content_html": "<p>Collectors know that card condition is everything. A Near Mint chase card or a pristine factory-sealed booster box can be ruined by careless transit. That is why every order shipped from our warehouse uses our signature <strong>4-Layer Collector Armor</strong> system.</p><h3>The 4 Layers of Protection</h3><ol><li><strong>Layer 1 — Acid-Free Inner Penny Sleeve:</strong> Protects the holo surface and edges from micro-scratches.</li><li><strong>Layer 2 — Rigid Toploader / Semi-Rigid Card Saver:</strong> Prevents bending or creasing under postal sorting pressure.</li><li><strong>Layer 3 — Resealable Team Bag &amp; Cardboard Stiffeners:</strong> Locks out moisture and prevents the card from sliding out of the toploader.</li><li><strong>Layer 4 — Reinforced Crush-Proof Mailer:</strong> Sealed booster boxes and graded PSA slabs are wrapped in high-density bubble wrap and shipped inside double-walled corrugated boxes.</li></ol>"
          },
          {
            "handle": "prismatic-evolutions-preorder-schedule",
            "url": "?article=prismatic-evolutions-preorder-schedule",
            "title": "Prismatic Evolutions Pre-order & Release Day Dispatch Info",
            "author": "TCGHaven Vault Team",
            "published_at": "November 02, 2026",
            "tag": "Release Drop",
            "image": {{ 'card-palkia.png' | asset_url | json }},
            "excerpt": "Check allocation waves, Elite Trainer Box contents, and guaranteed first-wave dispatch timelines.",
            "content_html": "<p>Prismatic Evolutions features Stellar Tera Eeveelutions and some of the most sought-after collector cards of the year, including Special Illustration Rare treatments for Umbreon, Sylveon, Espeon, and Leafeon.</p><h3>Pre-order Allocation &amp; Dispatch Guarantee</h3><p>Unlike stores that oversell unconfirmed distributor numbers, we only list confirmed first-wave allocations. Every pre-order placed on TCGHaven is locked at your checkout price and prepared in our warehouse 24 hours prior to official release day so your tracking number goes live immediately.</p>"
          }
        {%- endif -%}
      ]
    </script>

  </div>
</div>

{% schema %}
{
  "name": "TCG 博客文章列表",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "眉标", "default": "Collector Journal" },
    { "type": "text", "id": "heading", "label": "默认标题", "default": "News & Set Guides" },
    { "type": "textarea", "id": "subheading", "label": "副标题说明", "default": "In-depth set checklists, PSA & BGS grading guides, pull-rate breakdowns, and vault packaging insights from our collector team." }
  ],
  "presets": [
    { "name": "TCG 博客文章列表" }
  ]
}
{% endschema %}
