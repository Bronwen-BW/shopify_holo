{%- comment -%}
  TCG 付款与结账确认页（对接 Shopify 官方结账接口 routes.cart_checkout_url 与 form action="/cart"）
{%- endcomment -%}

<div
  class="_page_1z0wo_1"
  data-tcg-checkout-section
  data-currency-sample="{{ 1000 | money | escape }}"
>
  <div class="_wide_4xdw3_6">

    <ol class="_steps_16l9l_44" aria-label="Checkout progress" style="margin-bottom:clamp(1.5rem,4vh,2.5rem);width:fit-content;">
      <li class="_stepDone_16l9l_87" data-step-indicator="cart">
        <a href="{{ routes.cart_url }}" class="_stepLink_16l9l_54">
          <span class="_stepDot_16l9l_76" aria-hidden="true">✓</span>
          <span class="_stepLabel_16l9l_225">Cart</span>
        </a>
      </li>
      <li class="_stepCurrent_16l9l_96" data-step-indicator="checkout" aria-current="step">
        <span class="_stepLink_16l9l_54">
          <span class="_stepDot_16l9l_76" data-step-dot="checkout" aria-hidden="true">2</span>
          <span class="_stepLabel_16l9l_225">Checkout &amp; Payment</span>
        </span>
      </li>
      <li data-step-indicator="confirmation">
        <span class="_stepLink_16l9l_54">
          <span class="_stepDot_16l9l_76" data-step-dot="confirmation" aria-hidden="true">3</span>
          <span class="_stepLabel_16l9l_225">Confirmation</span>
        </span>
      </li>
    </ol>

    <div data-cart-step-panel="checkout">
      <header class="_header_1z0wo_6">
        <div>
          <h1 class="_heading_1z0wo_14">{{ section.settings.heading | default: 'Checkout & Payment' }}</h1>
          <p class="tcg-subtext">{{ section.settings.subheading | default: 'Review your order details and proceed to official Shopify encrypted payment.' }}</p>
        </div>
        <a href="{{ routes.cart_url }}" class="tcg-link-subtle">← Back to cart</a>
      </header>

      <form action="{{ routes.cart_url }}" method="post" class="tcg-checkout-grid" data-tcg-checkout-form novalidate>
        <div class="tcg-checkout-main">
          {%- comment %} 客户账户与收货地址卡片 {% endcomment -%}
          <section class="tcg-card-panel">
            <div class="tcg-panel-head">
              <h2>1. Customer &amp; Delivery Address</h2>
              {%- unless customer -%}
                <a href="{{ routes.account_login_url }}" class="tcg-link-accent">Sign in for faster checkout →</a>
              {%- endunless -%}
            </div>

            <div class="tcg-form-grid-2">
              <div class="tcg-form-row">
                <label for="PageCheckoutName" class="tcg-field-label">Full Name</label>
                <input type="text" id="PageCheckoutName" class="tcg-input" data-checkout-name value="{{ customer.name | default: 'Collector Guest' | escape }}" required>
              </div>
              <div class="tcg-form-row">
                <label for="PageCheckoutEmail" class="tcg-field-label">Email Address</label>
                <input type="email" id="PageCheckoutEmail" class="tcg-input" data-checkout-email value="{{ customer.email | default: 'collector@tcghaven.store' | escape }}" required>
              </div>
            </div>

            <div class="tcg-form-row" style="margin-top:0.85rem;">
              <label for="PageCheckoutAddress" class="tcg-field-label">Shipping Street Address</label>
              <input type="text" id="PageCheckoutAddress" class="tcg-input" data-checkout-address value="{{ customer.default_address.address1 | default: '151 Pallet Town Blvd, Suite 10' | escape }}" required>
            </div>

            <div class="tcg-form-grid-2" style="margin-top:0.85rem;">
              <div class="tcg-form-row">
                <label for="PageCheckoutCity" class="tcg-field-label">City</label>
                <input type="text" id="PageCheckoutCity" class="tcg-input" data-checkout-city value="{{ customer.default_address.city | default: 'Utrecht' | escape }}" required>
              </div>
              <div class="tcg-form-row">
                <label for="PageCheckoutZip" class="tcg-field-label">Postal / ZIP Code</label>
                <input type="text" id="PageCheckoutZip" class="tcg-input" data-checkout-zip value="{{ customer.default_address.zip | default: '3511 AA' | escape }}" required>
              </div>
            </div>

            <div class="tcg-form-row" style="margin-top:0.85rem;">
              <label for="PageCheckoutCountry" class="tcg-field-label">Country / Region</label>
              <input type="text" id="PageCheckoutCountry" class="tcg-input" data-checkout-country value="{{ customer.default_address.country | default: 'Netherlands / International' | escape }}" required>
            </div>
          </section>

          {%- comment %} 支付方式与安全说明 {% endcomment -%}
          <section class="tcg-card-panel">
            <h2>2. Supported Official Payment Methods</h2>
            <p class="tcg-muted-text">All transactions are encrypted and processed directly through Shopify Official Checkout.</p>
            <div class="tcg-payment-grid" data-payment-methods>
              <label class="tcg-payment-item tcg-payment-option is-selected" data-payment-option>
                <input type="radio" name="tcg_payment_method" value="Credit / Debit Card (Visa · Mastercard)" checked hidden>
                <strong>Credit &amp; Debit Cards</strong>
                <span>Visa, Mastercard, Maestro, American Express</span>
              </label>
              <label class="tcg-payment-item tcg-payment-option" data-payment-option>
                <input type="radio" name="tcg_payment_method" value="Express Wallet (Shop Pay / PayPal)" hidden>
                <strong>Express Wallets</strong>
                <span>Shop Pay, Apple Pay, Google Pay, PayPal</span>
              </label>
              <label class="tcg-payment-item tcg-payment-option" data-payment-option>
                <input type="radio" name="tcg_payment_method" value="European & Local Banking (iDEAL / Klarna)" hidden>
                <strong>European &amp; Local Banking</strong>
                <span>iDEAL, Bancontact, Klarna, SEPA Bank Transfer</span>
              </label>
            </div>

            <div class="tcg-form-row" style="margin-top:1.25rem;">
              <label for="CheckoutDiscountCode" class="tcg-field-label">Promo / Gift Card Code</label>
              <input type="text" id="CheckoutDiscountCode" name="discount" class="tcg-input" data-checkout-discount placeholder="Enter discount code to apply at Shopify Checkout">
            </div>

            <div class="tcg-form-row" style="margin-top:1rem;">
              <label for="CheckoutNote" class="tcg-field-label">Order / Delivery Instructions</label>
              <textarea id="CheckoutNote" name="note" rows="3" class="tcg-textarea" data-checkout-note placeholder="Special instructions for protective card packing or shipping…">{{ cart.note }}</textarea>
            </div>
          </section>
        </div>

        {%- comment %} 右侧订单汇总与完成购买 {% endcomment -%}
        <aside class="_summary_1z0wo_183">
          <h2 class="_summaryTitle_1z0wo_199">Order summary (<span data-checkout-item-count>{{ cart.item_count }}</span>)</h2>

          <div class="tcg-checkout-items" data-checkout-items-list>
            {%- for item in cart.items -%}
              <div class="tcg-checkout-item">
                <span>{{ item.quantity }}× {{ item.product.title }}{% if item.variant.title != 'Default Title' %} ({{ item.variant.title }}){% endif %}</span>
                <strong>{{ item.final_line_price | money }}</strong>
              </div>
            {%- endfor -%}
          </div>

          <div class="_summaryRow_1z0wo_208">
            <span>Subtotal</span>
            <span data-checkout-subtotal>{{ cart.total_price | default: 0 | money }}</span>
          </div>
          <div class="_summaryRow_1z0wo_208">
            <span>Shipping</span>
            <span style="color:var(--tcg-accent-hover);font-weight:600;">Free Tracked</span>
          </div>
          <div class="_summaryTotal_1z0wo_221">
            <span>Total due</span>
            <span data-checkout-total>{{ cart.total_price | default: 0 | money }}</span>
          </div>

          <button type="submit" name="checkout" class="_checkoutBtn_1z0wo_241" data-complete-order-btn>
            {{ section.settings.cta_label | default: 'Complete Purchase' }}
          </button>

          <a href="{{ routes.cart_checkout_url }}" class="tcg-btn-secondary" style="width:100%;text-align:center;margin-top:.5rem;">
            Official Shopify Checkout →
          </a>

          <p class="_summaryNote_1z0wo_291">256-bit SSL encrypted checkout powered by Shopify.</p>
        </aside>
      </form>
    </div>

    <div data-cart-step-panel="confirmation" hidden>
      <div class="tcg-card-panel tcg-confirmation-card">
        <div class="tcg-confirmation-head">
          <span class="tcg-confirmation-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
          </span>
          <div>
            <span class="tcg-eyebrow">Order Confirmed</span>
            <h1 class="_heading_1z0wo_14">Thank you for your purchase!</h1>
            <p class="tcg-subtext">Your collector order has been placed and is being prepared in our climate-controlled vault.</p>
          </div>
        </div>

        <div class="tcg-confirmation-meta-grid">
          <div class="tcg-payment-item">
            <span>Order Number</span>
            <strong data-order-number>#TCG-849201</strong>
          </div>
          <div class="tcg-payment-item">
            <span>Order Date</span>
            <strong data-order-date>Today</strong>
          </div>
          <div class="tcg-payment-item">
            <span>Payment Status</span>
            <strong data-order-payment style="color:var(--tcg-accent-hover);">Paid · Credit / Debit Card</strong>
          </div>
          <div class="tcg-payment-item">
            <span>Delivery Address</span>
            <strong data-order-address>Utrecht, Netherlands</strong>
          </div>
        </div>

        <div class="tcg-confirmation-items-wrap">
          <h2 class="_summaryTitle_1z0wo_199" style="margin-bottom:0.75rem;">Purchased Items</h2>
          <div class="tcg-checkout-items" data-order-confirmed-items></div>
          <div class="_summaryTotal_1z0wo_221" style="margin-top:0.85rem;">
            <span>Total Paid</span>
            <span data-order-confirmed-total>€0.00</span>
          </div>
        </div>

        <div class="tcg-confirmation-actions">
          <a href="{{ routes.all_products_collection_url }}" class="_checkoutBtn_1z0wo_241" style="width:auto;padding-inline:2rem;">Continue shopping</a>
          <a href="{{ routes.root_url }}" class="tcg-btn-secondary">Back to home</a>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TCG 付款与结账",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Checkout & Payment"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "副标题",
      "default": "Review your order details and proceed to official Shopify encrypted payment."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "付款按钮文字",
      "default": "Continue to Official Shopify Payment"
    }
  ],
  "presets": [
    {
      "name": "TCG 付款与结账"
    }
  ]
}
{% endschema %}
