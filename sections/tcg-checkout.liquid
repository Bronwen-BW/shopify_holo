{%- comment -%}
  TCG 付款与结账确认页（对接 Shopify 官方结账接口 routes.cart_checkout_url 与 form action="/cart"）
{%- endcomment -%}

<div class="_page_1z0wo_1" data-tcg-checkout-section>
  <div class="_wide_4xdw3_6">

    <ol class="_steps_16l9l_44" aria-label="Checkout progress" style="margin-bottom:clamp(1.5rem,4vh,2.5rem);width:fit-content;">
      <li class="_stepDone_16l9l_87">
        <a href="{{ routes.cart_url }}" class="_stepLink_16l9l_54">
          <span class="_stepDot_16l9l_76" aria-hidden="true">✓</span>
          <span class="_stepLabel_16l9l_225">Cart</span>
        </a>
      </li>
      <li class="_stepCurrent_16l9l_96" aria-current="step">
        <span class="_stepLink_16l9l_54">
          <span class="_stepDot_16l9l_76" aria-hidden="true">2</span>
          <span class="_stepLabel_16l9l_225">Checkout &amp; Payment</span>
        </span>
      </li>
      <li>
        <span class="_stepLink_16l9l_54">
          <span class="_stepDot_16l9l_76" aria-hidden="true">3</span>
          <span class="_stepLabel_16l9l_225">Confirmation</span>
        </span>
      </li>
    </ol>

    <header class="_header_1z0wo_6">
      <div>
        <h1 class="_heading_1z0wo_14">{{ section.settings.heading | default: 'Checkout & Payment' }}</h1>
        <p class="tcg-subtext">{{ section.settings.subheading | default: 'Review your order details and proceed to official Shopify encrypted payment.' }}</p>
      </div>
      <a href="{{ routes.cart_url }}" class="tcg-link-subtle">← Back to cart</a>
    </header>

    <form action="{{ routes.cart_url }}" method="post" class="tcg-checkout-grid">
      <div class="tcg-checkout-main">
        {%- comment %} 客户账户状态卡片 {% endcomment -%}
        <section class="tcg-card-panel">
          <div class="tcg-panel-head">
            <h2>1. Customer &amp; Delivery Account</h2>
            {%- unless customer -%}
              <a href="{{ routes.account_login_url }}?checkout_url={{ routes.cart_checkout_url | url_encode }}" class="tcg-link-accent">Sign in for faster checkout →</a>
            {%- endunless -%}
          </div>
          {%- if customer -%}
            <div class="tcg-customer-brief">
              <p><strong>{{ customer.name }}</strong> ({{ customer.email }})</p>
              {%- if customer.default_address -%}
                <p class="tcg-muted-text">
                  Default shipping address: {{ customer.default_address.address1 }}, {{ customer.default_address.city }} {{ customer.default_address.zip }}, {{ customer.default_address.country }}
                </p>
              {%- endif -%}
            </div>
          {%- else -%}
            <p class="tcg-muted-text">You can check out as a guest on the official Shopify Checkout screen, or sign in to use your saved addresses.</p>
          {%- endif -%}
        </section>

        {%- comment %} 支付方式与安全说明 {% endcomment -%}
        <section class="tcg-card-panel">
          <h2>2. Supported Official Payment Methods</h2>
          <p class="tcg-muted-text">All transactions are encrypted and processed directly through Shopify Official Checkout.</p>
          <div class="tcg-payment-grid">
            <div class="tcg-payment-item">
              <strong>Credit &amp; Debit Cards</strong>
              <span>Visa, Mastercard, Maestro, American Express</span>
            </div>
            <div class="tcg-payment-item">
              <strong>Express Wallets</strong>
              <span>Shop Pay, Apple Pay, Google Pay, PayPal</span>
            </div>
            <div class="tcg-payment-item">
              <strong>European &amp; Local Banking</strong>
              <span>iDEAL, Bancontact, Klarna, SEPA Bank Transfer</span>
            </div>
          </div>

          <div class="tcg-form-row" style="margin-top:1.25rem;">
            <label for="CheckoutDiscountCode" class="tcg-field-label">Promo / Gift Card Code</label>
            <input type="text" id="CheckoutDiscountCode" name="discount" class="tcg-input" placeholder="Enter discount code to apply at Shopify Checkout">
          </div>

          <div class="tcg-form-row" style="margin-top:1rem;">
            <label for="CheckoutNote" class="tcg-field-label">Order / Delivery Instructions</label>
            <textarea id="CheckoutNote" name="note" rows="3" class="tcg-textarea" placeholder="Special instructions for protective card packing or shipping…">{{ cart.note }}</textarea>
          </div>
        </section>
      </div>

      {%- comment %} 右侧订单汇总与跳转官方结账 {% endcomment -%}
      <aside class="_summary_1z0wo_183">
        <h2 class="_summaryTitle_1z0wo_199">Order summary ({{ cart.item_count }})</h2>

        {%- if cart.item_count > 0 -%}
          <div class="tcg-checkout-items">
            {%- for item in cart.items -%}
              <div class="tcg-checkout-item">
                <span>{{ item.quantity }}× {{ item.product.title }}{% if item.variant.title != 'Default Title' %} ({{ item.variant.title }}){% endif %}</span>
                <strong>{{ item.final_line_price | money }}</strong>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="_summaryRow_1z0wo_208">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <div class="_summaryRow_1z0wo_208">
          <span>Shipping</span>
          <span>Calculated at next step</span>
        </div>
        <div class="_summaryTotal_1z0wo_221">
          <span>Total due</span>
          <span>{{ cart.total_price | money }}</span>
        </div>

        <button type="submit" name="checkout" class="_checkoutBtn_1z0wo_241">
          {{ section.settings.cta_label | default: 'Continue to Official Shopify Payment' }}
        </button>

        <a href="{{ routes.cart_checkout_url }}" class="tcg-btn-secondary" style="width:100%;text-align:center;margin-top:.5rem;">
          Direct Express Checkout →
        </a>

        {%- if additional_checkout_buttons -%}
          <div class="tcg-additional-checkout">
            {{ content_for_additional_checkout_buttons }}
          </div>
        {%- endif -%}

        <p class="_summaryNote_1z0wo_291">256-bit SSL encrypted checkout powered by Shopify.</p>
      </aside>
    </form>
  </div>
</div>

{% schema %}
{
  "name": "TCG 付款与结账",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Checkout & Payment"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "副标题",
      "default": "Review your order details and proceed to official Shopify encrypted payment."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "付款按钮文字",
      "default": "Continue to Official Shopify Payment"
    }
  ],
  "presets": [
    {
      "name": "TCG 付款与结账"
    }
  ]
}
{% endschema %}
