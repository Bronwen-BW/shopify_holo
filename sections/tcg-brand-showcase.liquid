{%- comment -%}
  TCG 品牌展示主视觉分区（参考 KAMI KAMI 左文右图布局 + 右侧多图幻灯片轮播，配色与全站 TCG 翠绿/暗夜主题一致）
{%- endcomment -%}
{%- assign kicker = section.settings.kicker | default: 'FROM OUR IMAGINATION TO YOURS' -%}
{%- assign title = section.settings.title | default: 'NIOZONE' -%}
{%- assign lead_text = section.settings.lead_text | default: 'NIOZone 以擴散式卡磚、鑑定卡殼與卡牌周邊，讓收藏成為珍藏。從卡圖延伸到展示細節，為台灣與海外的收藏者呈現完整的作品風景。' -%}
{%- assign sub_text = section.settings.sub_text | default: 'We shape collectible display into a finished presentation language. From artwork extension to the acrylic frame itself, every detail brings your collection into focus. Explore our store to find your display style.' -%}

{%- assign btn1_label = section.settings.btn1_label | default: 'SHOP NOW' -%}
{%- assign btn1_url = section.settings.btn1_url | default: '/collections/all' -%}
{%- assign btn2_label = section.settings.btn2_label | default: 'View on Instagram' -%}
{%- assign btn2_url = section.settings.btn2_url | default: 'https://www.instagram.com/' -%}
{%- assign btn3_label = section.settings.btn3_label | default: '探索系列' -%}
{%- assign btn3_url = section.settings.btn3_url | default: '/pages/expansions' -%}
{%- assign autoplay_ms = section.settings.autoplay_ms | default: 4000 -%}

{%- assign slide_blocks = section.blocks | where: 'type', 'slide' -%}

<style>
  .tcg-kami-hero {
    padding: 48px 0 40px;
    position: relative;
    box-sizing: border-box;
  }
  body.template-index .tcg-kami-hero {
    padding-top: 96px;
  }
  .tcg-kami-hero__inner {
    width: min(1180px, calc(100% - 64px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(280px, 0.98fr);
    gap: clamp(28px, 3.6vw, 48px);
    align-items: center;
    box-sizing: border-box;
  }
  @media (max-width: 760px) {
    .tcg-kami-hero__inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
  .tcg-kami-hero__copy {
    position: relative;
    padding: 18px 0;
    z-index: 1;
  }
  .tcg-kami-hero__copy::before {
    content: "";
    position: absolute;
    inset: -30px auto auto -30px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--tcg-accent, #10b981) 20%, transparent), transparent 70%);
    filter: blur(12px);
    pointer-events: none;
    z-index: -1;
  }
  .tcg-kami-hero__kicker {
    display: inline-block;
    margin-bottom: 18px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--tcg-border-strong, rgba(249, 250, 251, 0.14));
    color: var(--tcg-text-secondary, #d4d4d8);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    background: var(--tcg-surface-soft, rgba(249, 250, 251, 0.04));
  }
  .tcg-kami-hero__title {
    margin: 0 0 18px 0;
    font-family: "Cormorant Garamond", "Playfair Display", Georgia, Rubik, serif;
    font-size: clamp(52px, 6.2vw, 84px);
    font-weight: 700;
    line-height: 0.94;
    letter-spacing: 0.02em;
    color: var(--tcg-text, #f9fafb);
  }
  .tcg-kami-hero__zh {
    margin: 0 0 16px 0;
    color: var(--tcg-accent-hover, #34d399);
    font-size: clamp(20px, 2.05vw, 25px);
    font-weight: 700;
    line-height: 1.75;
    letter-spacing: 0.01em;
  }
  .tcg-kami-hero__en {
    margin: 0;
    max-width: 560px;
    color: var(--tcg-text-muted, #9ca3af);
    font-size: 15.5px;
    line-height: 1.88;
  }
  .tcg-kami-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }
  .tcg-kami-hero__btn {
    min-height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    transition: transform 0.22s ease, box-shadow 0.22s ease, background-color 0.22s ease, border-color 0.22s ease;
    white-space: nowrap;
    text-decoration: none;
  }
  .tcg-kami-hero__btn:hover {
    transform: translateY(-2px);
  }
  .tcg-kami-hero__btn--primary {
    color: var(--tcg-accent-fg, #03231a);
    background: linear-gradient(135deg, var(--tcg-accent-hover, #34d399) 0%, var(--tcg-accent, #10b981) 100%);
    box-shadow: 0 14px 32px rgba(16, 185, 129, 0.28);
  }
  .tcg-kami-hero__btn--ghost {
    border: 1px solid var(--tcg-border-strong, rgba(249, 250, 251, 0.16));
    color: var(--tcg-text, #f9fafb);
    background: var(--tcg-surface-soft, rgba(249, 250, 251, 0.03));
  }
  .tcg-kami-hero__btn--ghost:hover {
    background: var(--tcg-surface-hover, rgba(249, 250, 251, 0.09));
  }
  .tcg-kami-hero__btn--accent-outline {
    color: var(--tcg-accent-hover, #34d399);
    border: 1px solid color-mix(in srgb, var(--tcg-accent, #10b981) 75%, transparent);
    background: var(--tcg-accent-soft, rgba(16, 185, 129, 0.10));
    box-shadow: inset 0 0 0 1px rgba(16, 185, 129, 0.08);
  }
  .tcg-kami-hero__btn--accent-outline:hover {
    background: rgba(16, 185, 129, 0.18);
  }
  .tcg-kami-hero__visual {
    position: relative;
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tcg-kami-hero__card {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1.02 / 1;
    border-radius: 30px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(249, 250, 251, 0.08), rgba(249, 250, 251, 0.02));
    border: 1px solid var(--tcg-border-strong, rgba(249, 250, 251, 0.14));
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.52);
  }
  .tcg-kami-hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: scale(1.03);
    transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1), transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    z-index: 1;
  }
  .tcg-kami-hero__slide.is-active {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
    z-index: 2;
  }
  .tcg-kami-hero__slide img {
    width: 100% !important;
    height: 100% !important;
    max-height: 520px !important;
    object-fit: cover !important;
    display: block !important;
  }
  .tcg-kami-hero__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(15, 17, 22, 0.68);
    backdrop-filter: blur(8px);
    color: #f9fafb;
    font-size: 20px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 4;
    opacity: 0;
    transition: opacity 0.22s ease, background-color 0.22s ease, border-color 0.22s ease;
  }
  .tcg-kami-hero__card:hover .tcg-kami-hero__nav {
    opacity: 1;
  }
  .tcg-kami-hero__nav:hover {
    background: rgba(16, 185, 129, 0.85);
    border-color: rgba(52, 211, 153, 0.9);
    color: #03231a;
  }
  .tcg-kami-hero__nav--prev {
    left: 14px;
  }
  .tcg-kami-hero__nav--next {
    right: 14px;
  }
  .tcg-kami-hero__dots {
    position: absolute;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(15, 17, 22, 0.62);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    z-index: 4;
  }
  .tcg-kami-hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: none;
    padding: 0;
    background: rgba(255, 255, 255, 0.36);
    cursor: pointer;
    transition: width 0.25s ease, background-color 0.25s ease;
  }
  .tcg-kami-hero__dot.is-active {
    width: 24px;
    background: var(--tcg-accent-hover, #34d399);
  }
</style>

<section class="tcg-kami-hero" data-tcg-brand-showcase data-autoplay-ms="{{ autoplay_ms }}">
  <div class="tcg-kami-hero__inner">
    <div class="tcg-kami-hero__copy">
      {%- if kicker != blank -%}
        <div class="tcg-kami-hero__kicker">{{ kicker }}</div>
      {%- endif -%}
      {%- if title != blank -%}
        <h2 class="tcg-kami-hero__title">{{ title }}</h2>
      {%- endif -%}
      {%- if lead_text != blank -%}
        <p class="tcg-kami-hero__zh">{{ lead_text }}</p>
      {%- endif -%}
      {%- if sub_text != blank -%}
        <p class="tcg-kami-hero__en">{{ sub_text }}</p>
      {%- endif -%}

      <div class="tcg-kami-hero__actions">
        {%- if btn1_label != blank -%}
          <a class="tcg-kami-hero__btn tcg-kami-hero__btn--primary" href="{{ btn1_url }}">{{ btn1_label }}</a>
        {%- endif -%}
        {%- if btn2_label != blank -%}
          <a class="tcg-kami-hero__btn tcg-kami-hero__btn--ghost" href="{{ btn2_url }}" {% if btn2_url contains 'http' %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ btn2_label }}</a>
        {%- endif -%}
        {%- if btn3_label != blank -%}
          <a class="tcg-kami-hero__btn tcg-kami-hero__btn--accent-outline" href="{{ btn3_url }}">{{ btn3_label }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="tcg-kami-hero__visual">
      <div class="tcg-kami-hero__card" data-kami-slider>
        {%- if slide_blocks.size > 0 -%}
          {%- for block in slide_blocks -%}
            {%- assign raw_s_img = block.settings.image_url | default: '' | strip -%}
            {%- if raw_s_img contains 'http://' or raw_s_img contains 'https://' -%}
              {%- assign s_img_src = raw_s_img -%}
            {%- elsif raw_s_img != '' -%}
              {%- assign s_asset_name = raw_s_img | remove: 'shopify://shop_images/' | split: '/' | last | default: 'brand-showcase-default.webp' -%}
              {%- assign s_img_src = s_asset_name | asset_url -%}
            {%- else -%}
              {%- assign s_img_src = 'brand-showcase-default.webp' | asset_url -%}
            {%- endif -%}
            <div class="tcg-kami-hero__slide{% if forloop.first %} is-active{% endif %}" data-kami-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}"><img src="{{ s_img_src }}" alt="{{ block.settings.title | default: title | escape }}" loading="lazy"></a>
              {%- else -%}
                <img src="{{ s_img_src }}" alt="{{ block.settings.title | default: title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- assign fallback_imgs = 'brand-showcase-default.webp,brand-showcase-2.webp,brand-showcase-3.webp' | split: ',' -%}
          {%- if section.settings.showcase_image != blank -%}
            {%- assign custom_list = section.settings.showcase_image -%}
            {%- if section.settings.showcase_image_2 != blank -%}{%- assign custom_list = custom_list | append: ',' | append: section.settings.showcase_image_2 -%}{%- endif -%}
            {%- if section.settings.showcase_image_3 != blank -%}{%- assign custom_list = custom_list | append: ',' | append: section.settings.showcase_image_3 -%}{%- endif -%}
            {%- assign fallback_imgs = custom_list | split: ',' -%}
          {%- endif -%}
          {%- for raw_item in fallback_imgs -%}
            {%- assign clean_item = raw_item | strip -%}
            {%- if clean_item contains 'http://' or clean_item contains 'https://' -%}
              {%- assign item_src = clean_item -%}
            {%- else -%}
              {%- assign item_asset = clean_item | remove: 'shopify://shop_images/' | split: '/' | last | default: 'brand-showcase-default.webp' -%}
              {%- assign item_src = item_asset | asset_url -%}
            {%- endif -%}
            <div class="tcg-kami-hero__slide{% if forloop.first %} is-active{% endif %}" data-kami-slide="{{ forloop.index0 }}">
              <img src="{{ item_src }}" alt="{{ title | escape }}" loading="lazy">
            </div>
          {%- endfor -%}
        {%- endif -%}

        <button type="button" class="tcg-kami-hero__nav tcg-kami-hero__nav--prev" data-kami-prev aria-label="Previous slide">&#8249;</button>
        <button type="button" class="tcg-kami-hero__nav tcg-kami-hero__nav--next" data-kami-next aria-label="Next slide">&#8250;</button>
        <div class="tcg-kami-hero__dots" data-kami-dots></div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    function initKamiSliders() {
      var sections = document.querySelectorAll('[data-tcg-brand-showcase]');
      sections.forEach(function(sec) {
        if (sec.dataset.kamiInitialized === '1') return;
        sec.dataset.kamiInitialized = '1';
        var slider = sec.querySelector('[data-kami-slider]');
        if (!slider) return;
        var slides = Array.prototype.slice.call(slider.querySelectorAll('[data-kami-slide]'));
        var dotsWrap = slider.querySelector('[data-kami-dots]');
        var prevBtn = slider.querySelector('[data-kami-prev]');
        var nextBtn = slider.querySelector('[data-kami-next]');
        if (slides.length <= 1) {
          if (dotsWrap) dotsWrap.style.display = 'none';
          if (prevBtn) prevBtn.style.display = 'none';
          if (nextBtn) nextBtn.style.display = 'none';
          return;
        }
        var current = 0;
        slides.forEach(function(s, i) { if (s.classList.contains('is-active')) current = i; });
        var dots = [];
        if (dotsWrap) {
          dotsWrap.innerHTML = '';
          slides.forEach(function(_, idx) {
            var d = document.createElement('button');
            d.type = 'button';
            d.className = 'tcg-kami-hero__dot' + (idx === current ? ' is-active' : '');
            d.setAttribute('aria-label', 'Slide ' + (idx + 1));
            d.addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();
              goTo(idx);
              restartTimer();
            });
            dotsWrap.appendChild(d);
            dots.push(d);
          });
        }
        function goTo(index) {
          current = (index + slides.length) % slides.length;
          slides.forEach(function(s, i) { s.classList.toggle('is-active', i === current); });
          dots.forEach(function(d, i) { d.classList.toggle('is-active', i === current); });
        }
        if (prevBtn) {
          prevBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            goTo(current - 1);
            restartTimer();
          });
        }
        if (nextBtn) {
          nextBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            goTo(current + 1);
            restartTimer();
          });
        }
        var intervalMs = parseInt(sec.getAttribute('data-autoplay-ms') || '4000', 10);
        if (isNaN(intervalMs) || intervalMs < 1500) intervalMs = 4000;
        var timer = null;
        function startTimer() {
          if (timer) clearInterval(timer);
          timer = setInterval(function() { goTo(current + 1); }, intervalMs);
        }
        function stopTimer() {
          if (timer) { clearInterval(timer); timer = null; }
        }
        function restartTimer() {
          stopTimer();
          startTimer();
        }
        slider.addEventListener('mouseenter', stopTimer);
        slider.addEventListener('mouseleave', startTimer);
        startTimer();
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initKamiSliders);
    } else {
      initKamiSliders();
    }
  })();
</script>

{% schema %}
{
  "name": "TCG 品牌展示主视觉 (KAMI 风格)",
  "tag": "section",
  "class": "tcg-brand-showcase-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "顶部胶囊小标题 (Kicker)",
      "default": "FROM OUR IMAGINATION TO YOURS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "品牌主标题 (Title)",
      "default": "NIOZONE"
    },
    {
      "type": "textarea",
      "id": "lead_text",
      "label": "核心导语（主题高亮色段落）",
      "default": "NIOZone 以擴散式卡磚、鑑定卡殼與卡牌周邊，讓收藏成為珍藏。從卡圖延伸到展示細節，為台灣與海外的收藏者呈現完整的作品風景。"
    },
    {
      "type": "textarea",
      "id": "sub_text",
      "label": "副标题说明段落（英文/次要文案）",
      "default": "We shape collectible display into a finished presentation language. From artwork extension to the acrylic frame itself, every detail brings your collection into focus. Explore our store to find your display style."
    },
    {
      "type": "header",
      "content": "按钮配置（留空按钮文字即隐藏该按钮）"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "主按钮文字 (Button 1)",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "主按钮跳转链接 (Button 1 URL)"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "次按钮文字 (Button 2)",
      "default": "View on Instagram"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "次按钮跳转链接 (Button 2 URL)"
    },
    {
      "type": "text",
      "id": "btn3_label",
      "label": "第三按钮文字 (Button 3)",
      "default": "探索系列"
    },
    {
      "type": "url",
      "id": "btn3_url",
      "label": "第三按钮跳转链接 (Button 3 URL)"
    },
    {
      "type": "header",
      "content": "右侧幻灯片轮播设置（也可在左侧结构树点击“+ 添加区块”自由增删幻灯片）"
    },
    {
      "type": "range",
      "id": "autoplay_ms",
      "label": "幻灯片自动切换间隔 (毫秒)",
      "min": 2000,
      "max": 9500,
      "step": 500,
      "default": 4000
    },
    {
      "type": "text",
      "id": "showcase_image",
      "label": "默认幻灯片图 1 (未添加子区块时生效)",
      "default": "brand-showcase-default.webp"
    },
    {
      "type": "text",
      "id": "showcase_image_2",
      "label": "默认幻灯片图 2 (未添加子区块时生效)",
      "default": "brand-showcase-2.webp"
    },
    {
      "type": "text",
      "id": "showcase_image_3",
      "label": "默认幻灯片图 3 (未添加子区块时生效)",
      "default": "brand-showcase-3.webp"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "轮播幻灯片 (Slide)",
      "settings": [
        {
          "type": "text",
          "id": "image_url",
          "label": "幻灯片图片 (上传本地图片或输入链接)",
          "default": "brand-showcase-default.webp"
        },
        {
          "type": "text",
          "id": "title",
          "label": "幻灯片备注标题 (可选)",
          "default": "Showcase Slide"
        },
        {
          "type": "url",
          "id": "link",
          "label": "点击跳转链接 (可选)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TCG 品牌展示主视觉 (KAMI 风格)",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "image_url": "brand-showcase-default.webp",
            "title": "精选卡砖展示 1"
          }
        },
        {
          "type": "slide",
          "settings": {
            "image_url": "brand-showcase-2.webp",
            "title": "精选卡砖展示 2"
          }
        },
        {
          "type": "slide",
          "settings": {
            "image_url": "brand-showcase-3.webp",
            "title": "精选卡砖展示 3"
          }
        }
      ]
    }
  ]
}
{% endschema %}
