{%- comment -%}
  TCG 重置密码页（使用 Shopify 官方 {% form 'reset_customer_password' %} 接口）
{%- endcomment -%}

<div class="_page_4xdw3_1">
  <div class="_wide_4xdw3_6">
    <div class="tcg-auth-shell">
      <section class="tcg-auth-card">
        <header class="tcg-auth-header">
          <span class="tcg-eyebrow">Security</span>
          <h1>Reset Account Password</h1>
          <p>Enter a new password for {{ email }}</p>
        </header>

        {%- form 'reset_customer_password', class: 'tcg-auth-form' -%}
          {%- if form.errors -%}
            <div class="tcg-alert tcg-alert-error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="tcg-form-row">
            <label for="ResetPassword" class="tcg-field-label">New password</label>
            <input type="password" name="customer[password]" id="ResetPassword" class="tcg-input" autocomplete="new-password" required>
          </div>

          <div class="tcg-form-row">
            <label for="PasswordConfirmation" class="tcg-field-label">Confirm new password</label>
            <input type="password" name="customer[password_confirmation]" id="PasswordConfirmation" class="tcg-input" autocomplete="new-password" required>
          </div>

          <button type="submit" class="_primaryButton_4xdw3_673" style="width:100%;">Save new password</button>
        {%- endform -%}
      </section>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TCG 重置密码",
  "settings": [],
  "presets": [
    {
      "name": "TCG 重置密码"
    }
  ]
}
{% endschema %}
