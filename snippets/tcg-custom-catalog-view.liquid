{%- comment -%}
  TCG 定制商品列表页视图组件（snippets/tcg-custom-catalog-view.liquid）
  设计规范：
  1. 已移除顶部大块 Hero 横幅（_hero_dtm2o_17），直接展示清爽的标题栏、分类筛选与定制商品网格（_grid_36e53_53）
  2. 商品卡片与模板 snippets/tcg-product-card.liquid（_card_36e53_65 _cardFill_36e53_74）100% 一致
  3. 点击商品卡片直接跳转至独立定制页面链接（如 /pages/custom-your-premium-card-extended-art-display-cases-collection）
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading | default: page.title | default: 'Custom Card Display Cases'
  assign grid_heading = section.settings.grid_heading | default: 'Custom Products Catalog'
  assign grid_subheading = section.settings.grid_subheading | default: 'Click any custom product below to open its standalone customization page.'
  assign fallback_card_img = 'card-charizard.png' | asset_url

  assign custom_blocks_count = 0
  for block in section.blocks
    if block.type == 'custom_product'
      assign custom_blocks_count = custom_blocks_count | plus: 1
    endif
  endfor
-%}

<div
  class="_page_dtm2o_1 tcg-custom-hub-root"
  data-tcg-custom-catalog-page
  data-custom-pages-json-url="{{ 'tcg-custom-pages.json' | asset_url }}"
  data-fallback-img-url="{{ fallback_card_img }}"
>
  <div data-custom-catalog-list-view>
    <div class="_wide_dtm2o_6">
      <header class="_header_1fncu_1" data-game="pokemon">
        <div class="_titleBlock_1fncu_34">
          <a href="{{ routes.all_products_collection_url }}" class="_back_1fncu_49">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><path d="m15 18-6-6 6-6"></path></svg>All products
          </a>
          <h1 data-reveal>{{ heading | escape }}</h1>
        </div>

        <nav aria-label="Custom categories" class="_tabs_1fncu_73">
          <button type="button" class="_tab_1fncu_73 _tabActive_1fncu_108 is-active" data-custom-filter-btn="all">All Custom</button>
          <button type="button" class="_tab_1fncu_73" data-custom-filter-btn="psa">PSA Slab Case</button>
          <button type="button" class="_tab_1fncu_73" data-custom-filter-btn="magnetic">Magnetic Case</button>
          <button type="button" class="_tab_1fncu_73" data-custom-filter-btn="screw">Screws Case</button>
          <button type="button" class="_tab_1fncu_73" data-custom-filter-btn="metal">PSA Metal Art</button>
        </nav>
      </header>
    </div>

    <section class="_section_36e53_1" id="tcg-custom-grid" style="padding-top: 0.5rem;">
      <div class="_wide_36e53_5">
        <header class="_header_36e53_10">
          <div>
            <h2>{{ grid_heading | escape }}</h2>
            <p>{{ grid_subheading | escape }}</p>
          </div>
          <div class="tcg-custom-catalog-controls">
            <div class="tcg-custom-search-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.35-4.35"></path></svg>
              <input
                type="search"
                class="tcg-custom-search-input"
                placeholder="Search custom cases…"
                aria-label="Search custom cases"
                data-custom-search-input
              >
            </div>
            <span class="tcg-custom-count-pill">
              <strong data-custom-visible-count>{% if custom_blocks_count > 0 %}{{ custom_blocks_count }}{% else %}1{% endif %}</strong> custom items
            </span>
          </div>
        </header>

        <div class="_grid_36e53_53" data-custom-products-grid>
          {%- if custom_blocks_count > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'custom_product' -%}
                {%- assign b_prod = block.settings.product -%}
                {%- assign b_title = block.settings.title | default: b_prod.title | default: 'Custom Card Extended Art Display Case' -%}
                {%- assign b_sub = block.settings.subtitle | default: b_prod.type | default: 'Bespoke Extended Art · Multi-SKU' -%}
                {%- assign b_badge = block.settings.badge | default: 'Custom' -%}
                {%- assign b_price = block.settings.price | default: '$35.99' -%}
                {%- assign b_compare = block.settings.compare_at_price | default: '$36.00' -%}
                {%- assign b_cat = block.settings.category | default: 'psa' | downcase -%}
                {%- assign b_slug = block.settings.handle_slug | default: 'custom-your-premium-card-extended-art-display-cases-collection' | handleize -%}
                {%- unless b_slug contains 'custom-' -%}
                  {%- assign b_slug = 'custom-' | append: b_slug -%}
                {%- endunless -%}
                {%- assign b_url = block.settings.custom_url | default: '/pages/' | append: b_slug -%}

                {%- if block.settings.image != blank -%}
                  {%- assign b_img = block.settings.image | image_url: width: 900 -%}
                {%- elsif block.settings.image_url != blank -%}
                  {%- assign b_img = block.settings.image_url -%}
                  {%- unless b_img contains '/' or b_img contains 'http' -%}
                    {%- assign b_img = b_img | asset_url -%}
                  {%- endunless -%}
                {%- elsif b_prod != blank and b_prod.featured_image != blank -%}
                  {%- assign b_img = b_prod.featured_image | image_url: width: 900 -%}
                {%- else -%}
                  {%- assign b_img = fallback_card_img -%}
                {%- endif -%}

                <article
                  data-motion-card="8"
                  class="_card_36e53_65 _cardFill_36e53_74"
                  data-reveal
                  data-custom-card-item
                  data-custom-slug="{{ b_slug | escape }}"
                  data-custom-category="{{ b_cat | escape }}"
                  data-custom-title="{{ b_title | downcase | escape }} {{ b_sub | downcase | escape }}"
                  {{ block.shopify_attributes }}
                >
                  <a href="{{ b_url }}" class="_cardMedia_36e53_85" aria-label="{{ b_title | escape }}" data-custom-page-link="{{ b_slug | escape }}">
                    <span class="_cardArtwork_36e53_122">
                      <img data-motion-art src="{{ b_img }}" onerror="this.onerror=null;this.src='{{ fallback_card_img }}';" alt="{{ b_title | escape }}" width="800" height="800" draggable="false" loading="lazy">
                    </span>
                    {%- if b_badge != blank -%}
                      <span class="_badge_36e53_217">{{ b_badge | escape }}</span>
                    {%- endif -%}
                  </a>

                  <div class="_cardBody_36e53_256">
                    <a href="{{ b_url }}" class="_cardInfo_36e53_264" data-custom-page-link="{{ b_slug | escape }}">
                      <span class="_cardName_36e53_275">{{ b_title | escape }}</span>
                      <span class="_cardSet_36e53_289">{{ b_sub | escape }}</span>
                    </a>

                    <div class="_cardFooter_36e53_309">
                      <span class="_cardPricing_36e53_326">
                        {%- if b_compare != blank -%}
                          <del>{{ b_compare | escape }}</del>
                        {%- endif -%}
                        <span class="_cardPrice_36e53_317">{{ b_price | escape }}</span>
                      </span>

                      <a
                        href="{{ b_url }}"
                        class="_addBtn_36e53_338"
                        data-custom-page-link="{{ b_slug | escape }}"
                        style="text-decoration:none;"
                      >
                        <span>Customize</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
                      </a>
                    </div>
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <article
              data-motion-card="8"
              class="_card_36e53_65 _cardFill_36e53_74"
              data-reveal
              data-custom-card-item
              data-custom-slug="custom-your-premium-card-extended-art-display-cases-collection"
              data-custom-category="psa magnetic screw metal"
              data-custom-title="custom your premium card extended art display cases collection psa slab magnetic screws metal art"
            >
              <a
                href="/pages/custom-your-premium-card-extended-art-display-cases-collection"
                class="_cardMedia_36e53_85"
                aria-label="Custom Your Premium Card Extended Art Display Cases Collection"
                data-custom-page-link="custom-your-premium-card-extended-art-display-cases-collection"
              >
                <span class="_cardArtwork_36e53_122">
                  <img
                    data-motion-art
                    src="{{ fallback_card_img }}"
                    alt="Custom Your Premium Card Extended Art Display Cases Collection"
                    width="800"
                    height="800"
                    draggable="false"
                    loading="lazy"
                  >
                </span>
                <span class="_badge_36e53_217">64 SKUs</span>
              </a>

              <div class="_cardBody_36e53_256">
                <a
                  href="/pages/custom-your-premium-card-extended-art-display-cases-collection"
                  class="_cardInfo_36e53_264"
                  data-custom-page-link="custom-your-premium-card-extended-art-display-cases-collection"
                >
                  <span class="_cardName_36e53_275">Custom Your Premium Card Extended Art Display Cases Collection</span>
                  <span class="_cardSet_36e53_289">Bespoke Extended Art · 4 Styles × 16 Frame Colors</span>
                </a>

                <div class="_cardFooter_36e53_309">
                  <span class="_cardPricing_36e53_326">
                    <del>$36.00</del>
                    <span class="_cardPrice_36e53_317">$35.99</span>
                  </span>

                  <a
                    href="/pages/custom-your-premium-card-extended-art-display-cases-collection"
                    class="_addBtn_36e53_338"
                    data-custom-page-link="custom-your-premium-card-extended-art-display-cases-collection"
                    style="text-decoration:none;"
                  >
                    <span>Customize</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
                  </a>
                </div>
              </div>
            </article>
          {%- endif -%}
        </div>

        <div class="tcg-empty-card" data-custom-empty-state hidden style="margin-top:1.5rem;">
          <h3>No matching custom display cases found</h3>
          <p class="tcg-muted-text">Try clearing your search filter or switching to "All Custom".</p>
          <button type="button" class="_primaryButton_4xdw3_673" data-custom-reset-filter style="margin-top:0.75rem;flex:none;">Show All Custom Items</button>
        </div>
      </div>
    </section>
  </div>

  <div data-custom-standalone-page-view hidden>
    {% render 'tcg-custom-product-form', section: section %}
  </div>
</div>
