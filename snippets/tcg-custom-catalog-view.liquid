{%- comment -%}
  TCG 定制商品列表页视图组件（snippets/tcg-custom-catalog-view.liquid）
  功能：
  1. 支持无限数量的定制商品展示（同时支持：Shopify 集合分页/无限加载 + 主题编辑器无上限 custom_product 区块 + 自动识别带 custom 标签商品）
  2. 商品卡片样式与模板 snippets/tcg-product-card.liquid（_card_36e53_65 _cardFill_36e53_74）100% 保持一致
  3. 点击任意商品卡片直接跳转到对应的定制商品详情链接（形式参考 /products/custom-your-premium-card-extended-art-display-cases-collection）
  4. 若 URL 带有 ?customize=<handle> 参数（用于尚未在后台创建独立 handle 的自定义商品块兜底），直接渲染完整定制详情页与表单
{%- endcomment -%}

{%- assign custom_collection_handle = section.settings.collection | default: 'custom' -%}
{%- assign custom_col = collections[custom_collection_handle] -%}
{%- assign fallback_base_product = all_products['custom-your-premium-card-extended-art-display-cases-collection'] -%}
{%- if fallback_base_product == blank and custom_col != blank and custom_col.products.size > 0 -%}
  {%- assign fallback_base_product = custom_col.products.first -%}
{%- endif -%}
{%- if fallback_base_product == blank and collections.all.products.size > 0 -%}
  {%- assign fallback_base_product = collections.all.products.first -%}
{%- endif -%}

{%- assign custom_blocks = section.blocks | where: 'type', 'custom_product' -%}
{%- assign per_page = section.settings.products_per_page | default: 24 -%}

{%- comment -%}
  包裹在支持列表视图 + 内置定制详情兜底视图的容器中：
  - 当跳转到真实存在的 /products/<handle>?custom=1 时，由商品模板直接渲染定制详情页
  - 当点击尚未在后台单独建品的自定义商品块且携带 ?customize=<slug> 时，本页无缝切换为同款定制详情视图
{%- endcomment -%}
<div class="tcg-custom-hub-root" data-tcg-custom-hub>

  {%- comment %} ================= 视图 A：定制商品列表页（默认展示，支持无限数量定制商品） ================= {% endcomment -%}
  <div class="_page_dtm2o_1" data-custom-catalog-list-view>
    <div class="_wide_dtm2o_6">

      {%- comment %} 顶部标题与分类快捷切换栏（与 tcg-collection.liquid 保持统一视觉） {% endcomment -%}
      <header class="_header_1fncu_1">
        <div class="_titleBlock_1fncu_34">
          <a href="{{ routes.all_products_collection_url }}" class="_back_1fncu_49">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>All products
          </a>
          <h1>{{ section.settings.heading | default: page.title | default: 'Custom Card Display Cases & Extended Art' }}</h1>
        </div>
        <nav class="_tabs_1fncu_73" aria-label="Custom product categories" data-custom-category-tabs>
          <button type="button" class="_tab_1fncu_73 _tabActive_1fncu_108" data-custom-filter-tab="all">All Custom</button>
          <button type="button" class="_tab_1fncu_73" data-custom-filter-tab="psa">PSA Slab Case</button>
          <button type="button" class="_tab_1fncu_73" data-custom-filter-tab="magnetic">Magnetic Case</button>
          <button type="button" class="_tab_1fncu_73" data-custom-filter-tab="screw">Screws Case</button>
          <button type="button" class="_tab_1fncu_73" data-custom-filter-tab="metal">PSA Metal Art</button>
        </nav>
      </header>

      {%- comment %} Hero 舞台：介绍定制流程 + 精选定制商品展示 {% endcomment -%}
      <section class="_hero_dtm2o_17">
        <div class="_intro_dtm2o_64">
          <p class="_descriptor_dtm2o_82">
            {{ section.settings.eyebrow | default: 'BESPOKE EXTENDED ARTWORK · UV-PROTECTED ACRYLIC & ANODIZED METAL ARMOR' }}
          </p>
          <p class="_blurb_dtm2o_93">
            {{ section.settings.blurb | default: 'Turn your favorite Pokémon, One Piece, Yu-Gi-Oh!, or Magic card into a museum-grade centerpiece. Choose any custom product below, select your SKU style & frame color, enter your email, upload multiple card photos, and add up to 10,000 characters of customization notes.' }}
          </p>

          <div class="_actions_dtm2o_101">
            <a href="#tcg-custom-grid" class="_primaryAction_dtm2o_108">Browse Custom Products</a>
            {%- if fallback_base_product != blank -%}
              <a href="{{ fallback_base_product.url }}?custom=1&preset=custom-your-premium-card-extended-art-display-cases-collection" class="_secondaryAction_dtm2o_154">Start Customizing Now →</a>
            {%- else -%}
              <a href="?customize=custom-your-premium-card-extended-art-display-cases-collection" class="_secondaryAction_dtm2o_154" data-open-inline-customizer="custom-your-premium-card-extended-art-display-cases-collection">Start Customizing Now →</a>
            {%- endif -%}
          </div>

          <div class="_stats_dtm2o_202">
            <span>15+ <em>Frame Colors</em></span>
            <span>4 <em>Case Styles</em></span>
            <span class="_statSoon_dtm2o_218">Multi-Photo &amp; 10,000-Char Notes</span>
          </div>
        </div>

        {%- assign hero_showcase_img = 'https://animeholder.com/cdn/shop/files/CardRequestYourCardPSASlabAcrylicCaseFrontSBlack.jpg?v=1780547492&width=1200' -%}
        {%- if section.settings.hero_image != blank -%}
          {%- assign hero_showcase_img = section.settings.hero_image | image_url: width: 1000 -%}
        {%- elsif fallback_base_product != blank and fallback_base_product.featured_image != blank -%}
          {%- assign hero_showcase_img = fallback_base_product.featured_image | image_url: width: 1000 -%}
        {%- endif -%}
        {%- assign hero_showcase_url = '/products/custom-your-premium-card-extended-art-display-cases-collection?custom=1' -%}
        {%- if fallback_base_product != blank -%}
          {%- assign hero_showcase_url = fallback_base_product.url | append: '?custom=1&preset=custom-your-premium-card-extended-art-display-cases-collection' -%}
        {%- endif -%}

        <a href="{{ hero_showcase_url }}" class="_showcase_dtm2o_223">
          <span class="_productStage_dtm2o_237">
            <img alt="Custom Your Premium Card Extended Art Display Cases Collection" draggable="false" src="{{ hero_showcase_img }}">
          </span>
          <span class="_showcaseCaption_dtm2o_271">
            <small>Featured Custom Showcase</small>
            <strong>Custom Your Premium Card Extended Art Display Cases Collection</strong>
          </span>
        </a>
      </section>

      {%- comment %} 4 步定制说明导航条 {% endcomment -%}
      <nav class="_destinations_dtm2o_310" aria-label="Customization workflow steps">
        <a href="#tcg-custom-grid"><strong>01 · Choose Custom Item &amp; SKU</strong><small>Select PSA Slab, Magnetic, Screw, or Metal Art</small></a>
        <a href="#tcg-custom-grid"><strong>02 · Upload Multiple Photos</strong><small>Upload front, back &amp; artwork reference images</small></a>
        <a href="#tcg-custom-grid"><strong>03 · Email &amp; 10,000-Char Notes</strong><small>Leave detailed design notes &amp; receive direct updates</small></a>
      </nav>
    </div>

    {%- comment %} ================= 定制商品网格（支持无限制个定制商品 + 实时搜索筛选 + 分页/加载更多） ================= {% endcomment -%}
    <section class="_section_36e53_1" id="tcg-custom-grid">
      <div class="_wide_36e53_5">
        <header class="_header_36e53_10" style="flex-wrap:wrap;gap:1rem;">
          <div>
            <h2>{{ section.settings.grid_heading | default: 'Custom Products Catalog' }}</h2>
            <p data-custom-catalog-count-text>{{ section.settings.grid_subheading | default: 'Click any product below to open its dedicated customization page.' }}</p>
          </div>

          <div class="tcg-custom-toolbar">
            <div class="tcg-custom-search-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.35-4.35"></path></svg>
              <input
                type="search"
                class="tcg-input tcg-custom-search-input"
                placeholder="Filter custom products by name, style, SKU…"
                aria-label="Filter custom products"
                data-custom-catalog-search
              >
            </div>
          </div>
        </header>

        {%- comment -%}
          商品列表渲染逻辑（支持无限数量）：
          1. 优先渲染主题编辑器中添加的所有 `custom_product` 区块（无数量上限，未设置 max_blocks）
          2. 接着渲染绑定的定制集合 `custom_col` 中的所有商品（通过 Shopify paginate 支持无限多商品，并提供 Load More 无限加载）
          3. 接着自动扫描全店带有 `custom` / `定制` 标签或 handle 含 `custom` 的商品并去重展示
          4. 若店铺尚未配置区块或专属定制商品，内置渲染与 animeholder.com 参考站一致的多款定制商品卡片（样式与 snippets/tcg-product-card.liquid 100% 相同）
        {%- endcomment -%}
        {%- assign rendered_handles = '|' -%}
        {%- assign total_rendered_cards = 0 -%}

        <div class="_grid_36e53_53" data-custom-products-grid>

          {%- comment %} 1) 渲染无数量上限的主题编辑器 custom_product 区块 {% endcomment -%}
          {%- for block in custom_blocks -%}
            {%- assign blk_product = all_products[block.settings.product] -%}
            {%- if blk_product != blank -%}
              {%- assign h_token = '|' | append: blk_product.handle | append: '|' -%}
              {%- assign rendered_handles = rendered_handles | append: blk_product.handle | append: '|' -%}
              {%- assign total_rendered_cards = total_rendered_cards | plus: 1 -%}
              {%- assign blk_url = block.settings.custom_url -%}
              {%- if blk_url == blank -%}
                {%- assign blk_url = blk_product.url | append: '?custom=1' -%}
              {%- endif -%}
              <div class="tcg-custom-grid-item" data-custom-card-item data-category="{{ block.settings.category | default: 'all' | downcase | escape }}" data-title="{{ block.settings.title | default: blk_product.title | downcase | escape }}" {{ block.shopify_attributes }}>
                {% render 'tcg-product-card', product: blk_product, custom_mode: true, custom_url: blk_url %}
              </div>
            {%- else -%}
              {%- assign total_rendered_cards = total_rendered_cards | plus: 1 -%}
              {%- assign item_title = block.settings.title | default: 'Custom Your Premium Card Extended Art Display Cases Collection' -%}
              {%- assign item_subtitle = block.settings.subtitle | default: 'Custom Case · Multi-SKU' -%}
              {%- assign item_badge = block.settings.badge | default: '60 SKUs' -%}
              {%- assign item_price = block.settings.price | default: '$35.99' -%}
              {%- assign item_compare = block.settings.compare_at_price | default: '$36.00' -%}
              {%- assign item_slug = block.settings.handle_slug | default: item_title | handleize -%}
              {%- if block.settings.image != blank -%}
                {%- assign item_img = block.settings.image | image_url: width: 800 -%}
              {%- elsif block.settings.image_url != blank -%}
                {%- assign item_img = block.settings.image_url -%}
              {%- else -%}
                {%- assign item_img = 'https://animeholder.com/cdn/shop/files/CardRequestYourCardPSASlabAcrylicCaseFrontSBlack.jpg?v=1780547492&width=800' -%}
              {%- endif -%}

              {%- comment %} 智能解析跳转链接：若填写了 custom_url 则优先使用；若对应 handle 商品在店铺存在则跳 /products/<handle>?custom=1；否则跳店铺首个商品页携带 preset 参数或本页内置定制器 {% endcomment -%}
              {%- assign matched_by_slug = all_products[item_slug] -%}
              {%- if block.settings.custom_url != blank -%}
                {%- assign target_url = block.settings.custom_url -%}
                {%- if target_url contains '/products/' -%}
                  {%- assign extracted_handle = target_url | split: '/products/' | last | split: '?' | first | split: '#' | first | strip -%}
                  {%- assign check_prod = all_products[extracted_handle] -%}
                  {%- if check_prod == blank and fallback_base_product != blank -%}
                    {%- assign target_url = fallback_base_product.url | append: '?custom=1&preset=' | append: extracted_handle | append: '&title=' | append: item_title | url_encode -%}
                  {%- elsif check_prod != blank -%}
                    {%- unless target_url contains 'custom=' or target_url contains 'view=custom' -%}
                      {%- if target_url contains '?' -%}
                        {%- assign target_url = target_url | append: '&custom=1' -%}
                      {%- else -%}
                        {%- assign target_url = target_url | append: '?custom=1' -%}
                      {%- endif -%}
                    {%- endunless -%}
                  {%- endif -%}
                {%- endif -%}
              {%- elsif matched_by_slug != blank -%}
                {%- assign target_url = matched_by_slug.url | append: '?custom=1' -%}
              {%- elsif fallback_base_product != blank -%}
                {%- assign target_url = fallback_base_product.url | append: '?custom=1&preset=' | append: item_slug -%}
              {%- else -%}
                {%- assign target_url = '?customize=' | append: item_slug -%}
              {%- endif -%}

              <article
                data-motion-card="8"
                class="_card_36e53_65 _cardFill_36e53_74"
                data-reveal
                data-custom-card-item
                data-category="{{ block.settings.category | default: 'all' | downcase | escape }}"
                data-title="{{ item_title | downcase | escape }} {{ item_subtitle | downcase | escape }}"
                {{ block.shopify_attributes }}
              >
                <a href="{{ target_url }}" class="_cardMedia_36e53_85" aria-label="{{ item_title | escape }}">
                  <span class="_cardArtwork_36e53_122">
                    <img
                      data-motion-art
                      src="{{ item_img }}"
                      alt="{{ item_title | escape }}"
                      width="800"
                      height="800"
                      draggable="false"
                      loading="lazy"
                    >
                  </span>
                  {%- if item_badge != blank -%}
                    <span class="_badge_36e53_217">{{ item_badge }}</span>
                  {%- endif -%}
                </a>

                <div class="_cardBody_36e53_256">
                  <a href="{{ target_url }}" class="_cardInfo_36e53_264">
                    <span class="_cardName_36e53_275">{{ item_title }}</span>
                    {%- if item_subtitle != blank -%}
                      <span class="_cardSet_36e53_289">{{ item_subtitle }}</span>
                    {%- endif -%}
                  </a>

                  <div class="_cardFooter_36e53_309">
                    <span class="_cardPricing_36e53_326">
                      {%- if item_compare != blank -%}
                        <del>{{ item_compare }}</del>
                      {%- endif -%}
                      <span class="_cardPrice_36e53_317">{{ item_price }}</span>
                    </span>

                    <a
                      href="{{ target_url }}"
                      class="_addBtn_36e53_338"
                      aria-label="Customize {{ item_title | escape }}"
                      style="text-decoration:none;"
                    >
                      <span>Customize</span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
                    </a>
                  </div>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}

          {%- comment %} 2) 若绑定了 Shopify 集合，分页渲染集合下全部定制商品（无数量上限） {% endcomment -%}
          {%- if custom_col != blank and custom_col.products.size > 0 -%}
            {%- paginate custom_col.products by per_page -%}
              {%- for product in custom_col.products -%}
                {%- assign h_check = '|' | append: product.handle | append: '|' -%}
                {%- unless rendered_handles contains h_check -%}
                  {%- assign rendered_handles = rendered_handles | append: product.handle | append: '|' -%}
                  {%- assign total_rendered_cards = total_rendered_cards | plus: 1 -%}
                  <div class="tcg-custom-grid-item" data-custom-card-item data-category="{{ product.type | default: 'all' | downcase | escape }}" data-title="{{ product.title | downcase | escape }}">
                    {% render 'tcg-product-card', product: product, custom_mode: true %}
                  </div>
                {%- endunless -%}
              {%- endfor -%}
            {%- endpaginate -%}
          {%- endif -%}

          {%- comment %} 3) 自动检索全店带有 custom / 定制 标签或 custom 模板的商品 {% endcomment -%}
          {%- if section.settings.auto_include_custom_tagged != false and collections.all.products.size > 0 -%}
            {%- for product in collections.all.products limit: 50 -%}
              {%- assign is_tagged_custom = false -%}
              {%- if product.template_suffix == 'custom' or product.handle contains 'custom' or product.type contains 'Custom' -%}
                {%- assign is_tagged_custom = true -%}
              {%- else -%}
                {%- for t in product.tags -%}
                  {%- assign tl = t | downcase -%}
                  {%- if tl == 'custom' or tl == 'customizable' or tl contains '定制' -%}
                    {%- assign is_tagged_custom = true -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- if is_tagged_custom -%}
                {%- assign h_check = '|' | append: product.handle | append: '|' -%}
                {%- unless rendered_handles contains h_check -%}
                  {%- assign rendered_handles = rendered_handles | append: product.handle | append: '|' -%}
                  {%- assign total_rendered_cards = total_rendered_cards | plus: 1 -%}
                  <div class="tcg-custom-grid-item" data-custom-card-item data-category="{{ product.type | default: 'all' | downcase | escape }}" data-title="{{ product.title | downcase | escape }}">
                    {% render 'tcg-product-card', product: product, custom_mode: true %}
                  </div>
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- comment %} 4) 若尚未配置任何 custom_product 区块或专属集合商品，默认渲染参考站同款定制商品矩阵（样式与模板 _card_36e53_65 完全一致） {% endcomment -%}
          {%- if total_rendered_cards == 0 -%}
            {%- assign demo_items = "custom-your-premium-card-extended-art-display-cases-collection|Custom Your Premium Card Extended Art Display Cases Collection|Extended Art Display Case · 4 Styles × 15 Colors|60 SKUs|$35.99|$36.00|psa|https://animeholder.com/cdn/shop/files/CardRequestYourCardPSASlabAcrylicCaseFrontSBlack.jpg?v=1780547492&width=800||custom-psa-slab-aluminum-extended-art-case|Custom PSA Slab Aluminum Extended Art Display Case|PSA Graded Slab Armor · 15 Anodized Colors|15 SKUs|$35.99|$39.99|psa|https://animeholder.com/cdn/shop/files/CardRequestYourCardPSASlabAcrylicCaseFrontSRainbow.jpg?v=1780547492&width=800||custom-magnetic-one-touch-extended-art-case|Custom Magnetic Load Extended Art Card Case|Zero-Tool Magnetic Closure · Crystal Acrylic|12 SKUs|$32.99|$36.00|magnetic|https://animeholder.com/cdn/shop/files/Card_Request_Your_Card_Magnetic_Case_Front_S.jpg?v=1780548249&width=800||custom-screw-fort-knox-extended-art-case|Custom Metal Screw Extended Art Collector Case|4-Corner Screw Lock · Double-Layer Acrylic|12 SKUs|$31.99|$35.00|screw|https://animeholder.com/cdn/shop/files/Card_Request_Your_Card_Screws_Case_Front_S.jpg?v=1780548263&width=800||custom-psa-metal-art-only-replacement-plate|Custom PSA Metal Extended Art Plate Only|Replacement Custom Printed Artwork Layer|15 SKUs|$24.99|$28.00|metal|https://animeholder.com/cdn/shop/files/Card_Request_Your_Card_PSA_Metal_Art_Front_S_7b06656a-fdda-489e-94f1-0496e9598453.jpg?v=1780548429&width=800||custom-sakura-pink-psa-extended-art-slab-case|Custom Sakura Edition Extended Art PSA Slab Case|Anodized Sakura Pink Frame · UV Protection|15 SKUs|$35.99|$36.00|psa|https://animeholder.com/cdn/shop/files/CardRequestYourCardPSASlabAcrylicCaseFrontSSakura.jpg?v=1780547492&width=800||custom-golden-sea-extended-art-slab-case|Custom Golden Sea Extended Art PSA Slab Case|Anodized Golden Sea Frame · Custom Artwork|15 SKUs|$35.99|$36.00|psa|https://animeholder.com/cdn/shop/files/CardRequestYourCardPSASlabAcrylicCaseFrontSGoldenSea.jpg?v=1780547491&width=800||custom-opal-mint-extended-art-slab-case|Custom Opal Mint Extended Art PSA Slab Case|Anodized Opal Mint Frame · Custom Artwork|15 SKUs|$35.99|$36.00|psa|https://animeholder.com/cdn/shop/files/CardRequestYourCardPSASlabAcrylicCaseFrontSOpalMint.jpg?v=1780547491&width=800" | split: "||" -%}

            {%- for raw_demo in demo_items -%}
              {%- assign parts = raw_demo | split: "|" -%}
              {%- assign d_slug = parts[0] -%}
              {%- assign d_title = parts[1] -%}
              {%- assign d_sub = parts[2] -%}
              {%- assign d_badge = parts[3] -%}
              {%- assign d_price = parts[4] -%}
              {%- assign d_compare = parts[5] -%}
              {%- assign d_cat = parts[6] -%}
              {%- assign d_img = parts[7] -%}

              {%- assign real_prod = all_products[d_slug] -%}
              {%- if real_prod != blank -%}
                {%- assign d_url = real_prod.url | append: '?custom=1' -%}
              {%- elsif fallback_base_product != blank -%}
                {%- assign d_url = fallback_base_product.url | append: '?custom=1&preset=' | append: d_slug -%}
              {%- else -%}
                {%- assign d_url = '?customize=' | append: d_slug -%}
              {%- endif -%}

              <article
                data-motion-card="8"
                class="_card_36e53_65 _cardFill_36e53_74"
                data-reveal
                data-custom-card-item
                data-category="{{ d_cat }}"
                data-title="{{ d_title | downcase | escape }} {{ d_sub | downcase | escape }}"
              >
                <a href="{{ d_url }}" class="_cardMedia_36e53_85" aria-label="{{ d_title | escape }}">
                  <span class="_cardArtwork_36e53_122">
                    <img
                      data-motion-art
                      src="{{ d_img }}"
                      alt="{{ d_title | escape }}"
                      width="800"
                      height="800"
                      draggable="false"
                      loading="lazy"
                    >
                  </span>
                  <span class="_badge_36e53_217">{{ d_badge }}</span>
                </a>

                <div class="_cardBody_36e53_256">
                  <a href="{{ d_url }}" class="_cardInfo_36e53_264">
                    <span class="_cardName_36e53_275">{{ d_title }}</span>
                    <span class="_cardSet_36e53_289">{{ d_sub }}</span>
                  </a>

                  <div class="_cardFooter_36e53_309">
                    <span class="_cardPricing_36e53_326">
                      <del>{{ d_compare }}</del>
                      <span class="_cardPrice_36e53_317">{{ d_price }}</span>
                    </span>

                    <a
                      href="{{ d_url }}"
                      class="_addBtn_36e53_338"
                      aria-label="Customize {{ d_title | escape }}"
                      style="text-decoration:none;"
                    >
                      <span>Customize</span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
                    </a>
                  </div>
                </div>
              </article>
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- comment %} 无限商品动态加载器（当绑定集合商品超过单页数量时，支持一键加载更多或无限滚动） {% endcomment -%}
        {%- if custom_col != blank and custom_col.products_count > per_page -%}
          <div class="tcg-custom-load-more-wrap" data-custom-infinite-wrap data-collection-handle="{{ custom_col.handle }}" data-total-count="{{ custom_col.products_count }}" data-per-page="{{ per_page }}">
            <button type="button" class="tcg-btn-secondary" data-custom-load-more-btn>
              Load More Custom Products ({{ custom_col.products_count }} total)
            </button>
          </div>
        {%- endif -%}

      </div>
    </section>
  </div>

  {%- comment %} ================= 视图 B：当 URL 携带 ?customize=<slug> 时的内置定制商品详情兜底视图 ================= {% endcomment -%}
  <div data-custom-inline-detail-view hidden>
    {% render 'tcg-custom-product-form', product: fallback_base_product, section: section, is_inline_hub: true %}
  </div>

</div>
