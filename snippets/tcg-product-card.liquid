{%- comment -%}
  TCG 产品卡（网格通用组件）
  入参：product（产品对象）、lazy（是否懒加载，默认 true）
  支持展示多 SKU 数量标识、原价对比及 Shopify 官方 AJAX 加购
{%- endcomment -%}
{%- assign is_preorder = false -%}
{%- assign is_explicit_soldout = false -%}
{%- for tag in product.tags -%}
  {%- assign tag_down = tag | downcase -%}
  {%- if tag_down contains 'pre' -%}{%- assign is_preorder = true -%}{%- endif -%}
  {%- if tag_down == 'soldout' or tag_down == 'sold-out' -%}{%- assign is_explicit_soldout = true -%}{%- endif -%}
{%- endfor -%}
{%- assign current_variant = product.selected_or_first_available_variant | default: product.first_available_variant | default: product.variants.first -%}
{%- assign card_available = false -%}
{%- if product.available -%}
  {%- assign card_available = true -%}
{%- elsif current_variant -%}
  {%- if current_variant.available or current_variant.inventory_policy == 'continue' or current_variant.inventory_management == blank or current_variant.inventory_quantity > 0 -%}
    {%- assign card_available = true -%}
  {%- endif -%}
{%- endif -%}
{%- if card_available == false -%}
  {%- for v_item in product.variants -%}
    {%- if v_item.available or v_item.inventory_policy == 'continue' or v_item.inventory_management == blank or v_item.inventory_quantity > 0 -%}
      {%- assign current_variant = v_item -%}
      {%- assign card_available = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if card_available == false and is_explicit_soldout == false and current_variant != blank -%}
  {%- assign card_available = true -%}
{%- endif -%}
{%- assign card_img_obj = current_variant.featured_image | default: product.featured_image -%}
{%- if card_img_obj != blank -%}
  {%- assign card_thumb_url = card_img_obj | image_url: width: 240 -%}
{%- else -%}
  {%- assign card_thumb_url = 'logo-mark.png' | asset_url -%}
{%- endif -%}
{%- assign card_variant_price = current_variant.price | default: product.price | default: 0 -%}
{%- assign is_custom_card = false -%}
{%- if custom_mode == true -%}
  {%- assign is_custom_card = true -%}
{%- elsif product.template_suffix == 'custom' or product.handle contains 'custom' -%}
  {%- assign is_custom_card = true -%}
{%- else -%}
  {%- for tag in product.tags -%}
    {%- assign t_low = tag | downcase -%}
    {%- if t_low == 'custom' or t_low == 'customizable' or t_low contains '定制' -%}
      {%- assign is_custom_card = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign card_target_url = custom_url | default: product.url -%}
{%- if is_custom_card and custom_url == blank and card_target_url != blank -%}
  {%- unless card_target_url contains 'custom=' or card_target_url contains 'view=custom' -%}
    {%- if card_target_url contains '?' -%}
      {%- assign card_target_url = card_target_url | append: '&custom=1' -%}
    {%- else -%}
      {%- assign card_target_url = card_target_url | append: '?custom=1' -%}
    {%- endif -%}
  {%- endunless -%}
{%- endif -%}

<article data-motion-card="8" class="_card_36e53_65 _cardFill_36e53_74" data-reveal>
  {%- comment %} 媒体区（整卡可点击） {% endcomment -%}
  <a href="{{ card_target_url }}" class="_cardMedia_36e53_85" aria-label="{{ product.title | escape }}">
    <span class="_cardArtwork_36e53_122">
      {%- if product.featured_image -%}
        <img
          data-motion-art
          src="{{ product.featured_image | image_url: width: 800 }}"
          alt="{{ product.title | escape }}"
          width="{{ product.featured_image.width }}"
          height="{{ product.featured_image.height }}"
          draggable="false"
          {% unless lazy == false %}loading="lazy"{% endunless %}
        >
      {%- else -%}
        <img data-motion-art src="{{ 'logo-mark.png' | asset_url }}" alt="{{ product.title | escape }}" draggable="false" loading="lazy">
      {%- endif -%}
    </span>

    {%- comment %} 状态徽章：预售 / 定制 / 多规格 / 新品 {% endcomment -%}
    {%- if is_preorder -%}
      <span class="_badge_36e53_217 _badgePreorder_36e53_232">Pre-order</span>
    {%- elsif is_custom_card and product.variants.size > 1 -%}
      <span class="_badge_36e53_217">Custom · {{ product.variants.size }} SKUs</span>
    {%- elsif is_custom_card -%}
      <span class="_badge_36e53_217">Custom</span>
    {%- elsif product.variants.size > 1 -%}
      <span class="_badge_36e53_217">{{ product.variants.size }} SKUs</span>
    {%- else -%}
      <span class="_badge_36e53_217">New</span>
    {%- endif -%}

    {%- comment %} 预售倒计时（仅当产品定义了发布日期 metafield 时显示） {% endcomment -%}
    {%- if product.metafields.custom.release_date != blank -%}
      <span class="_preorderCountdown_36e53_237" data-countdown="{{ product.metafields.custom.release_date | date: '%Y-%m-%dT%H:%M:%S' }}">Releases in <strong>—</strong></span>
    {%- endif -%}
  </a>

  {%- comment %} 信息区 {% endcomment -%}
  <div class="_cardBody_36e53_256">
    <a href="{{ card_target_url }}" class="_cardInfo_36e53_264">
      <span class="_cardName_36e53_275">{{ product.title }}</span>
      {%- if product.type != blank -%}
        <span class="_cardSet_36e53_289">{{ product.type }}{% if current_variant.sku != blank %} · {{ current_variant.sku }}{% endif %}</span>
      {%- elsif current_variant.sku != blank -%}
        <span class="_cardSet_36e53_289">SKU: {{ current_variant.sku }}</span>
      {%- elsif is_custom_card -%}
        <span class="_cardSet_36e53_289">Custom Extended Art · Multi-SKU</span>
      {%- endif -%}
    </a>

    <div class="_cardFooter_36e53_309">
      <span class="_cardPricing_36e53_326">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <del>{{ current_variant.compare_at_price | money }}</del>
        {%- endif -%}
        <span class="_cardPrice_36e53_317">
          {%- if product.price_varies -%}From {{ product.price_min | money }}{%- else -%}{{ product.price | money }}{%- endif -%}
        </span>
      </span>

      {%- if is_custom_card -%}
        <a
          href="{{ card_target_url }}"
          class="_addBtn_36e53_338"
          aria-label="Customize {{ product.title | escape }}"
          style="text-decoration:none;"
        >
          <span>Customize</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
        </a>
      {%- else -%}
        {%- comment %} 加购按钮（使用 Shopify 官方 /cart/add.js 接口 + 本地购物车兜底同步） {% endcomment -%}
        <button
          type="button"
          class="_addBtn_36e53_338"
          data-add
          data-variant="{{ current_variant.id | default: product.id }}"
          data-product-id="{{ product.id }}"
          data-product-handle="{{ product.handle | escape }}"
          data-product-title="{{ product.title | escape }}"
          data-variant-title="{% if current_variant.title != 'Default Title' %}{{ current_variant.title | escape }}{% endif %}"
          data-variant-sku="{{ current_variant.sku | escape }}"
          data-variant-price="{{ card_variant_price }}"
          data-variant-price-formatted="{{ card_variant_price | money | escape }}"
          data-product-url="{{ product.url | default: routes.all_products_collection_url }}"
          data-product-image="{{ card_thumb_url }}"
          {% unless card_available %}disabled{% endunless %}
          aria-label="Add {{ product.title | escape }} to cart"
        >
          <span>{% if card_available == false %}Sold out{% elsif is_preorder %}Pre-order{% else %}Add{% endif %}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"></path></svg>
        </button>
      {%- endif -%}
    </div>
  </div>
</article>
