        <div class="tcg-exp-detail-hero-inner">
          <div class="tcg-exp-detail-logo-box">
            <img data-exp-detail-logo src="https://images.scrydex.com/magicthegathering/FDN-logo/logo" alt="">
          </div>

          <div class="tcg-exp-detail-info">
            <div class="tcg-exp-detail-title-row">
              <h1 data-exp-detail-title>Foundations</h1>
              <span class="tcg-exp-detail-symbol-wrap" title="Set Symbol">
                <img data-exp-detail-symbol src="https://images.scrydex.com/magicthegathering/FDN-symbol/symbol" alt="" onerror="this.parentElement.style.display='none'">
