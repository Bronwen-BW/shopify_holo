{%- comment -%}
  TCG Expansions 页面核心视图（复刻 https://scrydex.com/magicthegathering/expansions 功能与交互逻辑，融合店铺现有 TCG 暗黑/明亮双模视觉风格，不包含 Filters 功能）
  核心特性：
  1. 顶部 Expansions Header：游戏徽标 + 标题 + 背景水印 Logo + 简介文案 + 统计概览 + Grid / Table 视图模式切换器（无右侧 Filters 侧边栏）
  2. 分组快速锚点导航栏（支持一键平滑滚动定位到 24 个系列分类：expansion / core / commander / masters 等）
  3. 完整支持 Grid（网格 Logo 卡片）与 Table（Expansion Name / ID / Cards / Release Date 四列表格）双视图无缝切换，并持久化到 localStorage('view-mode')
  4. 点击任意扩展包卡片或表格行，支持无刷新切换到该扩展包的详情/商品选购视图（或跳转到绑定的 Shopify 集合）
{%- endcomment -%}

{%- assign page_heading = section.settings.heading | default: 'Magic: The Gathering' -%}
{%- assign page_desc = section.settings.description | default: 'Master the Multiverse. Explore the vast history of Magic: The Gathering expansions, from Alpha to the most recent planeswalking adventures.' -%}
{%- assign default_view = section.settings.default_view_mode | default: 'grid' -%}
{%- assign game_icon_url = section.settings.game_icon_url | default: 'https://scrydex.com/assets/tcgs/icon_magicthegathering-e2151698e87443ceccb0ad4b6c98dac19d1b244cce24bac76f52c506046d5833.png' -%}
{%- assign header_bg_logo = section.settings.header_watermark_url | default: 'https://scrydex.com/assets/tcgs/logo_mtg-a99225ad3a6ecb7c7fdc9c579a187289aee78c3eeb577f92086dcc8a57f1738e.png' -%}

<div
  class="_page_4xdw3_1 tcg-expansions-page"
  data-tcg-expansions-section
  data-controller="view-mode"
  data-view-mode-initial-value="{{ default_view }}"
>
  <div class="_wide_4xdw3_6">

    {%- comment %} ================= 1. 扩展包总览主视图 ================= {% endcomment -%}
    <div data-expansions-list-view>

      {%- comment %} 面包屑导航（保持店铺统一胶囊面包屑风格） {% endcomment -%}
      <nav aria-label="Breadcrumb" class="_breadcrumb_4xdw3_11">
        <a aria-label="Back to home" href="{{ routes.root_url }}" class="_crumbBack_4xdw3_69">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
        </a>
        <ol>
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="{{ routes.collections_url }}">Collections</a></li>
          <li aria-current="page"><span class="_crumbGame_4xdw3_89" data-game="magic">{{ page_heading }} Expansions</span></li>
        </ol>
      </nav>

      {%- comment %} 顶部 Header 横幅（复刻 #expansions-header，融入店铺卡片与光效风格，右侧集成 Grid / Table 视图切换器，不含 Filters） {% endcomment -%}
      <section id="expansions-header" class="tcg-exp-header">
        <div id="expansions-header-bg" class="tcg-exp-header-bg" aria-hidden="true">
          <img src="{{ header_bg_logo }}" alt="" loading="lazy">
        </div>

        <div class="tcg-exp-header-inner">
          <div class="tcg-exp-header-top">
            <div id="expansions-header-badge" class="tcg-exp-badge">
              <span class="tcg-exp-badge-icon">
                <img src="{{ game_icon_url }}" alt="{{ page_heading | escape }}" width="32" height="32">
              </span>
              <div>
                <span class="tcg-eyebrow">Expansion Archive &amp; Set Directory</span>
                <h1 class="tcg-exp-title">{{ page_heading }}</h1>
              </div>
            </div>

            {%- comment %} View Mode 切换器（Grid / Table，保留原页面核心交互逻辑，去除 Filters） {% endcomment -%}
            <div class="tcg-exp-toolbar" role="toolbar" aria-label="View Mode">
              <div class="tcg-exp-view-label">
                <span class="tcg-exp-view-dot"></span>
                <span>View Mode</span>
              </div>
              <div class="tcg-exp-view-switch" role="group" aria-label="Switch between Grid and Table view">
                <button
                  type="button"
                  class="tcg-exp-view-btn is-active"
                  data-view-mode-target="button"
                  data-action="click->view-mode#change"
                  data-mode="grid"
                  aria-pressed="true"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                    <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                    <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                    <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                  </svg>
                  <span>Grid</span>
                </button>
                <button
                  type="button"
                  class="tcg-exp-view-btn"
                  data-view-mode-target="button"
                  data-action="click->view-mode#change"
                  data-mode="table"
                  aria-pressed="false"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                    <line x1="3" y1="15" x2="21" y2="15"></line>
                    <line x1="9" y1="10" x2="9" y2="20"></line>
                  </svg>
                  <span>Table</span>
                </button>
              </div>
            </div>
          </div>

          <p id="expansions-header-description" class="tcg-exp-desc">
            {{ page_desc }}
          </p>

          <div class="tcg-exp-meta-bar">
            <div class="tcg-exp-stat-pill">
              <strong data-expansions-total-count>827</strong>
              <span>Total Expansions</span>
            </div>
            <div class="tcg-exp-stat-pill">
              <strong data-expansions-group-count>24</strong>
              <span>Set Categories</span>
            </div>
            <div class="tcg-exp-stat-pill">
              <strong>1993 – 2026</strong>
              <span>Alpha to Latest Releases</span>
            </div>
          </div>
        </div>
      </section>

      {%- comment %} 分类快速定位胶囊条（纯页内锚点跳转，非 Filter 过滤） {% endcomment -%}
      <nav class="tcg-exp-jump-nav" aria-label="Expansion categories quick jump" data-expansions-jump-nav>
        <a href="#exp-group-expansion" class="tcg-exp-jump-pill is-active" data-exp-jump="expansion">expansion <em>118</em></a>
        <a href="#exp-group-core" class="tcg-exp-jump-pill" data-exp-jump="core">core <em>25</em></a>
        <a href="#exp-group-commander" class="tcg-exp-jump-pill" data-exp-jump="commander">commander <em>45</em></a>
        <a href="#exp-group-masters" class="tcg-exp-jump-pill" data-exp-jump="masters">masters <em>32</em></a>
        <a href="#exp-group-draft-innovation" class="tcg-exp-jump-pill" data-exp-jump="draft-innovation">draft innovation <em>19</em></a>
        <a href="#exp-group-masterpiece" class="tcg-exp-jump-pill" data-exp-jump="masterpiece">masterpiece <em>20</em></a>
        <a href="#exp-group-eternal" class="tcg-exp-jump-pill" data-exp-jump="eternal">eternal <em>4</em></a>
        <a href="#exp-group-promo" class="tcg-exp-jump-pill" data-exp-jump="promo">promo <em>287</em></a>
        <a href="#exp-group-alchemy" class="tcg-exp-jump-pill" data-exp-jump="alchemy">alchemy <em>14</em></a>
        <a href="#exp-group-funny" class="tcg-exp-jump-pill" data-exp-jump="funny">funny <em>19</em></a>
        <a href="#exp-group-memorabilia" class="tcg-exp-jump-pill" data-exp-jump="memorabilia">memorabilia <em>86</em></a>
        <a href="#exp-group-token" class="tcg-exp-jump-pill" data-exp-jump="token">token <em>22</em></a>
        <a href="#exp-group-minigame" class="tcg-exp-jump-pill" data-exp-jump="minigame">minigame <em>14</em></a>
        <a href="#exp-group-box" class="tcg-exp-jump-pill" data-exp-jump="box">box <em>46</em></a>
        <a href="#exp-group-arsenal" class="tcg-exp-jump-pill" data-exp-jump="arsenal">arsenal <em>3</em></a>
        <a href="#exp-group-starter" class="tcg-exp-jump-pill" data-exp-jump="starter">starter <em>15</em></a>
        <a href="#exp-group-spellbook" class="tcg-exp-jump-pill" data-exp-jump="spellbook">spellbook <em>3</em></a>
        <a href="#exp-group-planechase" class="tcg-exp-jump-pill" data-exp-jump="planechase">planechase <em>6</em></a>
        <a href="#exp-group-duel-deck" class="tcg-exp-jump-pill" data-exp-jump="duel-deck">duel deck <em>28</em></a>
        <a href="#exp-group-from-the-vault" class="tcg-exp-jump-pill" data-exp-jump="from-the-vault">from the vault <em>10</em></a>
        <a href="#exp-group-archenemy" class="tcg-exp-jump-pill" data-exp-jump="archenemy">archenemy <em>4</em></a>
        <a href="#exp-group-treasure-chest" class="tcg-exp-jump-pill" data-exp-jump="treasure-chest">treasure chest <em>2</em></a>
        <a href="#exp-group-premium-deck" class="tcg-exp-jump-pill" data-exp-jump="premium-deck">premium deck <em>3</em></a>
        <a href="#exp-group-vanguard" class="tcg-exp-jump-pill" data-exp-jump="vanguard">vanguard <em>2</em></a>
      </nav>

      {%- comment %} 商家自定义高亮系列区块（若在 Shopify 主题编辑器中配置了自定义系列 Block 则优先置顶渲染） {% endcomment -%}
      {%- if section != blank and section.blocks.size > 0 -%}
        <section class="tcg-exp-group" data-expansion-group="featured">
          <div class="tcg-exp-group-head">
            <h2>Featured Store Expansions</h2>
            <span class="tcg-exp-group-badge">{{ section.blocks.size }} sets</span>
          </div>

          <div data-view-mode-target="grid" class="tcg-exp-grid">
            {%- for block in section.blocks -%}
              {%- assign b_col = collections[block.settings.collection] -%}
              {%- assign b_code = block.settings.code | default: 'MTG' -%}
              {%- assign b_name = block.settings.name | default: b_col.title | default: 'Featured Expansion' -%}
              {%- assign b_date = block.settings.release_date | default: '2026/11/13' -%}
              {%- assign b_cards = block.settings.cards_count | default: b_col.products_count | default: 350 -%}
              {%- assign b_logo = block.settings.logo_url -%}
              {%- if b_logo == blank -%}
                {%- assign b_logo = 'https://images.scrydex.com/magicthegathering/' | append: b_code | append: '-logo/logo' -%}
              {%- endif -%}
              {%- assign b_url = b_col.url | default: '?expansion=' | append: b_code -%}

              <a
                href="{{ b_url }}"
                class="tcg-exp-card"
                data-expansion-card
                data-expansion-id="{{ b_code | escape }}"
                data-expansion-name="{{ b_name | escape }}"
                data-expansion-date="{{ b_date | escape }}"
                data-expansion-cards="{{ b_cards }}"
                data-expansion-group-name="featured"
                data-expansion-logo="{{ b_logo | escape }}"
                {% if b_col != blank %}data-collection-url="{{ b_col.url }}"{% endif %}
                {{ block.shopify_attributes }}
              >
                <div class="tcg-exp-card-inner">
                  <div class="tcg-exp-card-logo">
                    {%- if block.settings.image != blank -%}
                      <img src="{{ block.settings.image | image_url: width: 480 }}" alt="{{ b_name | escape }}" loading="lazy">
                    {%- else -%}
                      <img src="{{ b_logo }}" alt="{{ b_name | escape }}" loading="lazy" data-exp-logo="{{ b_code | escape }}">
                    {%- endif -%}
                  </div>
                  <div class="tcg-exp-card-meta">
                    <span class="tcg-exp-card-name">{{ b_name }}</span>
                    <span class="tcg-exp-card-date">{{ b_date }}</span>
                  </div>
                </div>
              </a>
            {%- endfor -%}
          </div>

          <div data-view-mode-target="table" class="tcg-exp-table-wrap hidden">
            <table class="tcg-exp-table">
              <thead>
                <tr>
                  <th>Expansion Name</th>
                  <th class="is-center">ID</th>
                  <th class="is-center">Cards</th>
                  <th class="is-right">Release Date</th>
                </tr>
              </thead>
              <tbody>
                {%- for block in section.blocks -%}
                  {%- assign b_col = collections[block.settings.collection] -%}
                  {%- assign b_code = block.settings.code | default: 'MTG' -%}
                  {%- assign b_name = block.settings.name | default: b_col.title | default: 'Featured Expansion' -%}
                  {%- assign b_date = block.settings.release_date | default: '2026/11/13' -%}
                  {%- assign b_cards = block.settings.cards_count | default: b_col.products_count | default: 350 -%}
                  {%- assign b_logo = block.settings.logo_url -%}
                  {%- if b_logo == blank -%}
                    {%- assign b_logo = 'https://images.scrydex.com/magicthegathering/' | append: b_code | append: '-logo/logo' -%}
                  {%- endif -%}
                  {%- assign b_url = b_col.url | default: '?expansion=' | append: b_code -%}

                  <tr
                    class="tcg-exp-row"
                    data-action="click->view-mode#navigateToCard"
                    data-expansion-row
                    data-expansion-id="{{ b_code | escape }}"
                    data-expansion-name="{{ b_name | escape }}"
                    data-expansion-date="{{ b_date | escape }}"
                    data-expansion-cards="{{ b_cards }}"
                    data-expansion-group-name="featured"
                    data-expansion-logo="{{ b_logo | escape }}"
                    data-url="{{ b_url }}"
                  >
                    <td>
                      <div class="tcg-exp-row-Main">
                        <div class="tcg-exp-row-logo">
                          {%- if block.settings.image != blank -%}
                            <img src="{{ block.settings.image | image_url: width: 240 }}" alt="{{ b_name | escape }}" loading="lazy">
                          {%- else -%}
                            <img src="{{ b_logo }}" alt="{{ b_name | escape }}" loading="lazy" data-exp-logo="{{ b_code | escape }}">
                          {%- endif -%}
                        </div>
                        <span class="tcg-exp-row-name">{{ b_name }}</span>
                      </div>
                    </td>
                    <td class="is-center"><span class="tcg-exp-mono-id">{{ b_code }}</span></td>
                    <td class="is-center"><span class="tcg-exp-mono-cards">{{ b_cards }}</span></td>
                    <td class="is-right"><span class="tcg-exp-mono-date">{{ b_date }}</span></td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        </section>
      {%- endif -%}

      {%- comment %}
        全量 24 个系列分组容器：
        首屏预渲染核心系列（保证 SSR 与静态预览即刻呈现），随后由 tcg-expansions-data.js + tcg.js 无缝挂载全部 24 组 827 个扩展包
      {%- endcomment -%}
      <div id="search_results_frame" class="tcg-exp-groups" data-expansions-groups-container>
        {%- assign ssr_items = "Star Trek|TRK|613|2026/11/13,Reality Fracture|FRA|479|2026/10/02,The Hobbit|HOB|336|2026/08/14,Marvel Super Heroes|MSH|480|2026/06/26,Secrets of Strixhaven|SOS|382|2026/04/24,Teenage Mutant Ninja Turtles|TMT|330|2026/03/06,Lorwyn Eclipsed|ECL|421|2026/01/23,Avatar: The Last Airbender|TLA|416|2025/11/21,Marvel's Spider-Man|SPM|293|2025/09/26,Edge of Eternities|EOE|411|2025/08/01,Final Fantasy|FIN|624|2025/06/13,Tarkir: Dragonstorm|TDM|442|2025/04/11,Aetherdrift|DFT|567|2025/02/14,Duskmourn: House of Horror|DSK|438|2024/09/27,Bloomburrow|BLB|428|2024/08/02,The Big Score|BIG|102|2024/04/19,Outlaws of Thunder Junction|OTJ|393|2024/04/19,Murders at Karlov Manor|MKM|454|2024/02/09" | split: "," -%}
        <section id="exp-group-expansion" class="tcg-exp-group" data-expansion-group="expansion">
          <div class="tcg-exp-group-head">
            <h2>expansion</h2>
            <span class="tcg-exp-group-badge">118 sets</span>
          </div>

          <div data-view-mode-target="grid" class="tcg-exp-grid">
            {%- for raw_item in ssr_items -%}
              {%- assign parts = raw_item | split: "|" -%}
              {%- assign item_name = parts[0] -%}
              {%- assign item_id = parts[1] -%}
              {%- assign item_cards = parts[2] -%}
              {%- assign item_date = parts[3] -%}
              {%- assign item_logo = 'https://images.scrydex.com/magicthegathering/' | append: item_id | append: '-logo/logo' -%}
              <a
                href="?expansion={{ item_id }}"
                class="tcg-exp-card"
                data-expansion-card
                data-expansion-id="{{ item_id }}"
                data-expansion-name="{{ item_name | escape }}"
                data-expansion-date="{{ item_date }}"
                data-expansion-cards="{{ item_cards }}"
                data-expansion-group-name="expansion"
                data-expansion-logo="{{ item_logo }}"
              >
                <div class="tcg-exp-card-inner">
                  <div class="tcg-exp-card-logo">
                    <img src="{{ item_logo }}" alt="{{ item_name | escape }}" loading="lazy" data-exp-logo="{{ item_id }}">
                  </div>
                  <div class="tcg-exp-card-meta">
                    <span class="tcg-exp-card-name">{{ item_name }}</span>
                    <span class="tcg-exp-card-date">{{ item_date }}</span>
                  </div>
                </div>
              </a>
            {%- endfor -%}
          </div>

          <div data-view-mode-target="table" class="tcg-exp-table-wrap hidden">
            <table class="tcg-exp-table">
              <thead>
                <tr>
                  <th>Expansion Name</th>
                  <th class="is-center">ID</th>
                  <th class="is-center">Cards</th>
                  <th class="is-right">Release Date</th>
                </tr>
              </thead>
              <tbody>
                {%- for raw_item in ssr_items -%}
                  {%- assign parts = raw_item | split: "|" -%}
                  {%- assign item_name = parts[0] -%}
                  {%- assign item_id = parts[1] -%}
                  {%- assign item_cards = parts[2] -%}
                  {%- assign item_date = parts[3] -%}
                  {%- assign item_logo = 'https://images.scrydex.com/magicthegathering/' | append: item_id | append: '-logo/logo' -%}
                  <tr
                    class="tcg-exp-row"
                    data-action="click->view-mode#navigateToCard"
                    data-expansion-row
                    data-expansion-id="{{ item_id }}"
                    data-expansion-name="{{ item_name | escape }}"
                    data-expansion-date="{{ item_date }}"
                    data-expansion-cards="{{ item_cards }}"
                    data-expansion-group-name="expansion"
                    data-expansion-logo="{{ item_logo }}"
                    data-url="?expansion={{ item_id }}"
                  >
                    <td>
                      <div class="tcg-exp-row-Main">
                        <div class="tcg-exp-row-logo">
                          <img src="{{ item_logo }}" alt="{{ item_name | escape }}" loading="lazy" data-exp-logo="{{ item_id }}">
                        </div>
                        <span class="tcg-exp-row-name">{{ item_name }}</span>
                      </div>
                    </td>
                    <td class="is-center"><span class="tcg-exp-mono-id">{{ item_id }}</span></td>
                    <td class="is-center"><span class="tcg-exp-mono-cards">{{ item_cards }}</span></td>
                    <td class="is-right"><span class="tcg-exp-mono-date">{{ item_date }}</span></td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        </section>
      </div>

    </div>

    {%- comment %} ================= 2. 扩展包详情与卡牌/商品浏览视图（点击任意扩展包卡片或表格行时无缝切换） ================= {% endcomment -%}
    <div data-expansion-detail-view hidden>
      <nav aria-label="Breadcrumb" class="_breadcrumb_4xdw3_11">
        <a aria-label="Back to expansions" href="#all-expansions" class="_crumbBack_4xdw3_69" data-back-to-expansions>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
        </a>
        <ol>
          <li><a href="{{ routes.root_url }}">Home</a></li>
