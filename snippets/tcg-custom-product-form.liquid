            <div class="tcg-custom-field-group">
              <label class="tcg-custom-field-label" for="CustomCustomerEmail">
                Customer Email <span class="tcg-custom-required">*</span>
                <small class="tcg-custom-field-hint">We will send your 1-on-1 custom artwork proof to this email before production</small>
              </label>
              <input
                type="email"
                id="CustomCustomerEmail"
                name="properties[Customer Email]"
                class="tcg-input tcg-custom-email-input"
                placeholder="collector@example.com"
                value="{% if customer %}{{ customer.email | escape }}{% endif %}"
                required
                autocomplete="email"
                data-custom-email-input
              >
              <p class="tcg-custom-field-error" data-custom-email-error hidden>Please enter a valid email address so we can send your custom proof.</p>
            </div>

            <div class="tcg-custom-field-group">
              <div class="tcg-custom-option-label-row">
                <label class="tcg-custom-field-label" for="CustomImagesPicker">
                  Upload Your Card / Reference Images (Multiple Supported) <span class="tcg-custom-required">*</span>
                </label>
                <span class="tcg-custom-upload-counter" data-custom-image-count-badge>0 images selected</span>
              </div>

              <div
                class="tcg-custom-upload-dropzone"
                data-custom-upload-dropzone
                tabindex="0"
                role="button"
                aria-label="Upload multiple card or reference images"
              >
                <input
                  type="file"
                  id="CustomImagesPicker"
                  accept="image/jpeg,image/png,image/webp,image/gif,image/heic"
                  multiple
                  class="tcg-custom-file-picker-hidden"
                  data-custom-multi-file-picker
                >
                <div class="tcg-custom-upload-prompt">
                  <span class="tcg-custom-upload-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="20" height="20"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                  </span>
                  <div>
                    <strong>Click to select multiple images or drag &amp; drop here</strong>
                    <span>Supports JPG, PNG, WEBP, GIF — synced directly to Shopify Order</span>
                  </div>
                </div>
              </div>

              <div class="tcg-custom-upload-preview-grid" data-custom-upload-preview-grid hidden></div>
              <div data-custom-dynamic-file-inputs hidden></div>
              <input type="hidden" name="properties[Uploaded Images Summary]" value="None" data-custom-images-summary-input>
              <p class="tcg-custom-field-error" data-custom-images-error hidden>Please upload at least 1 card or reference image for your custom order.</p>
            </div>

            <div class="tcg-custom-field-group">
              <div class="tcg-custom-option-label-row">
                <label class="tcg-custom-field-label" for="CustomOrderNotes">
                  Customization Notes (Up to 10,000 Characters)
                </label>
                <span class="tcg-custom-char-counter" data-custom-notes-counter>0 / 10,000 characters</span>
              </div>
              <textarea
                id="CustomOrderNotes"
                name="properties[Customization Notes]"
                class="tcg-textarea tcg-custom-notes-textarea"
                rows="3"
                maxlength="10000"
                placeholder="Describe your customization requests in detail (up to 10,000 characters): card name, set number, background extension style, aura effects, text engraving, grading company slab dimensions (PSA / BGS / CGC), or any special requests..."
                data-custom-notes-textarea
              ></textarea>
            </div>

            <p class="tcg-custom-feedback-msg" data-custom-form-feedback hidden role="status"></p>
          </div>

          {%- comment %} 3. 购买按钮栏（与 sections/tcg-product.liquid 原生双按钮与结账流程 100% 一致） {% endcomment -%}
          <div class="_buyArea_4xdw3_623 tcg-buy-area-inline">
            <div aria-label="Quantity" class="_quantity_4xdw3_629" data-quantity>
              <button type="button" aria-label="Decrease quantity" data-qty-minus>−</button>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                max="999"
                step="1"
                aria-label="Quantity"
                class="tcg-qty-input"
                data-qty-input
                data-qty-display
              >
              <button type="button" aria-label="Increase quantity" data-qty-plus>+</button>
            </div>

            <div class="tcg-dual-action-btns">
              <button
                type="submit"
                name="add"
                class="_primaryButton_4xdw3_673 tcg-compact-action-btn"
                data-add-to-cart-btn
                data-custom-submit-cart
                data-variant="{{ default_variant_id }}"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="17" height="17"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                <span data-add-to-cart-text>Add to cart</span>
              </button>

              <button
                type="button"
                class="tcg-buy-now-btn tcg-compact-action-btn"
                data-buy-now-btn
                data-custom-buy-now
                data-variant="{{ default_variant_id }}"
                data-checkout-url="{{ routes.cart_url }}?buy_now=1"
                data-official-checkout-url="{{ routes.cart_checkout_url }}"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="17" height="17"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
                <span data-buy-now-text>Buy it now</span>
              </button>
            </div>
          </div>

          {%- comment %} 加购成功反馈横幅（与 sections/tcg-product.liquid 原生结构完全一致，含 View cart 与 Checkout now 直达入口） {% endcomment -%}
          <div class="_addedNotice_4xdw3_750" data-added-notice data-custom-added-notice hidden>
            <span class="_addedCheck_4xdw3_769" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M20 6 9 17l-5-5"></path></svg>
            </span>
            <span class="_addedText_4xdw3_784" data-added-notice-text>Added to cart</span>
            <div class="_addedActions_4xdw3_791">
              <a href="{{ routes.cart_url }}" class="_viewCart_4xdw3_797">
                <span>View cart</span>
                <span class="_viewCartCount_4xdw3_852" data-added-cart-count>{{ cart.item_count }}</span>
              </a>
              <a href="{{ routes.cart_checkout_url }}" class="_checkoutNow_4xdw3_864" data-checkout-now-link>Checkout now</a>
            </div>
          </div>

          <div class="_purchaseFoot_4xdw3_936">
            <div><span>Artwork Proof</span><strong>Sent via Email</strong></div>
            <div><span>Protection</span><strong>UV &amp; Anodized Frame</strong></div>
            <div><span>Order Sync</span><strong>Direct in Admin</strong></div>
          </div>
        </form>
      </aside>
    </section>

    {%- comment %} 主图点击放大高清灯箱（与 sections/tcg-product.liquid 原生灯箱一致） {% endcomment -%}
    <div class="tcg-lightbox" data-image-lightbox role="dialog" aria-modal="true" aria-label="Product image zoom preview" hidden>
      <div class="tcg-lightbox-backdrop" data-lightbox-close></div>
      <div class="tcg-lightbox-dialog">
        <button type="button" class="tcg-lightbox-close" data-lightbox-close aria-label="Close zoom preview">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M18 6 6 18M6 6l12 12"></path></svg>
        </button>
        <div class="tcg-lightbox-stage">
          <div class="tcg-lightbox-img-wrap" data-lightbox-img-wrap>
            <img data-lightbox-image src="{{ img_charizard }}" alt="{{ custom_title | escape }}">
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
