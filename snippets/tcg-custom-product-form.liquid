{%- comment -%}
  TCG 独立定制商品详情页面组件 (snippets/tcg-custom-product-form.liquid)
  核心特性：
  1. 平衡双栏布局（彻底解决左空右挤）：
     - 左栏：高清主图 + 缩略图画廊 + 无限可折叠富文本商品信息栏 (Accordions) + 4项服务保障
     - 右栏：商品标题/价格 + 1~5层多类型 SKU 选择器（①纯文字 / ②图片+文字 / ③颜色+文字含渐变色）+ 定制表单（Email/多图/万字备注）+ 与模板商品完全一致的加购与立即购买付款按钮
  2. 支持从 assets/tcg-custom-pages.json 动态水合 1~5 层 SKU、Shopify 云端图片与无限可折叠富文本信息栏
{%- endcomment -%}

{%- liquid
  assign fallback_p = custom_product | default: product
  if fallback_p == blank and collections['all'] != blank and collections['all'].products.size > 0
    for cand in collections['all'].products
      if cand.available
        assign fallback_p = cand
        break
      endif
    endfor
    if fallback_p == blank
      assign fallback_p = collections['all'].products.first
    endif
  endif

  assign active_variant = fallback_p.selected_or_first_available_variant | default: fallback_p.variants.first
  assign default_variant_id = active_variant.id | default: 0

  assign resolved_handle = custom_handle | default: page.handle | default: 'custom-your-premium-card-extended-art-display-cases-collection'
  assign custom_title = 'Custom Your Premium Card Extended Art Display Cases Collection'
  if custom_page != blank and custom_page.title != blank and custom_page.handle != 'custom'
    assign custom_title = custom_page.title
  elsif section.settings.custom_title != blank
    assign custom_title = section.settings.custom_title
  endif

  assign brand_name = section.settings.brand_name | default: 'AnimeHolder Studio'
  assign base_price_cents = 3599
  assign compare_price_cents = 3600

  assign img_charizard = 'card-charizard.png' | asset_url
  assign img_umbreon = 'card-umbreon.png' | asset_url
  assign img_blastoise = 'card-blastoise.png' | asset_url
  assign img_venusaur = 'card-venusaur.png' | asset_url
  assign img_palkia = 'card-palkia.png' | asset_url
-%}

