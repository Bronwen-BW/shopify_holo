{%- comment -%}
  TCG 风格浮动面板页脚
  全部页面入口均使用 Shopify 官方路由与政策接口（routes / pages / shop.policies）
{%- endcomment -%}
{%- assign brand_prefix = section.settings.brand_prefix | default: 'TCG' -%}
{%- assign brand_accent = section.settings.brand_accent | default: 'Haven' -%}
{%- assign blurb = section.settings.blurb | default: 'A haven for collectors. Singles, sealed product, and accessories across the games you play, condition-checked and shipped fast.' -%}
{%- assign ig_url = section.settings.instagram_url | default: 'https://www.instagram.com/mylittletcghaven/' -%}
{%- assign pay_note = section.settings.payments_note | default: 'Secure checkout powered by Shopify Payments' -%}

{%- assign about_url = pages['about'].url | default: pages['about-us'].url | default: '/pages/about' -%}
{%- assign contact_url = pages['contact'].url | default: pages['contact-us'].url | default: '/pages/contact' -%}
{%- assign blog_url = blogs['news'].url | default: blogs['最新消息'].url | default: '/blogs/news' -%}
{%- assign shipping_url = pages['shipping-returns'].url | default: shop.shipping_policy.url | default: '/pages/shipping-returns' -%}
{%- assign policy_url = pages['policy'].url | default: shop.privacy_policy.url | default: '/pages/policy' -%}
{%- assign privacy_url = shop.privacy_policy.url | default: '/policies/privacy-policy' -%}
{%- assign terms_url = shop.terms_of_service.url | default: '/policies/terms-of-service' -%}
{%- assign refund_url = shop.refund_policy.url | default: '/policies/refund-policy' -%}

<footer class="_footer_23f90_1" data-tcg-footer>
  <div class="_wide_23f90_6 _panel_23f90_11">
    <div class="_top_23f90_17">

      {%- comment %} 品牌列 {% endcomment -%}
      <div class="_brandCol_23f90_35">
        <a href="{{ routes.root_url }}" class="_logo_23f90_48" aria-label="{{ brand_prefix }}{{ brand_accent }}">
          <span class="_logoMark_23f90_60"><img src="{{ 'logo-mark.png' | asset_url }}" alt="" width="34" height="34"></span>
          <span class="_logoText_23f90_75">{{ brand_prefix }}<span class="_logoAccent_23f90_83">{{ brand_accent }}</span></span>
        </a>
        <p class="_blurb_23f90_88">{{ blurb }}</p>
        <nav class="_socials_23f90_95" aria-label="Social media">
          <a target="_blank" rel="noopener noreferrer" href="{{ ig_url }}" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.4 2h9.2A5.4 5.4 0 0 1 22 7.4v9.2a5.4 5.4 0 0 1-5.4 5.4H7.4A5.4 5.4 0 0 1 2 16.6V7.4A5.4 5.4 0 0 1 7.4 2Zm-.2 2A3.2 3.2 0 0 0 4 7.2v9.6A3.2 3.2 0 0 0 7.2 20h9.6a3.2 3.2 0 0 0 3.2-3.2V7.2A3.2 3.2 0 0 0 16.8 4H7.2Zm10.3 1.5a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"></path></svg>
          </a>
        </nav>
      </div>

      {%- comment %} Shop 链接列 {% endcomment -%}
      <div class="_linkCol_23f90_160">
        <h3 class="_linkHeading_23f90_181">Shop</h3>
        <a href="{{ routes.all_products_collection_url }}">All products</a>
        <a href="{{ routes.collections_url }}">All collections</a>
        <a href="{{ routes.search_url }}?q=&amp;filter.type=Single">Single cards</a>
        <a href="{{ routes.search_url }}?q=&amp;filter.type=Sealed">Sealed products</a>
        {%- if section != blank and section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'footer_link' and block.settings.column == 'shop' -%}
              <a href="{{ block.settings.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- comment %} Account 链接列 {% endcomment -%}
      <div class="_linkCol_23f90_160">
        <h3 class="_linkHeading_23f90_181">Account</h3>
        <a href="{{ routes.account_url }}">My account</a>
        <a href="{{ routes.account_login_url }}">Sign in</a>
        <a href="{{ routes.account_register_url }}">Create account</a>
        <a href="{{ routes.cart_url }}">Shopping cart</a>
        <a href="{{ routes.cart_checkout_url }}">Checkout</a>
        {%- if section != blank and section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'footer_link' and block.settings.column == 'account' -%}
              <a href="{{ block.settings.url | default: routes.account_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- comment %} Company & Policies 链接列 {% endcomment -%}
      <div class="_linkCol_23f90_160">
        <h3 class="_linkHeading_23f90_181">Company &amp; Policies</h3>
        <a href="{{ about_url }}">About us</a>
        <a href="{{ blog_url }}">Collector Journal (Articles)</a>
        <a href="{{ contact_url }}">Contact</a>
        <a href="{{ shipping_url }}">Shipping &amp; returns</a>
        <a href="{{ policy_url }}">Store policies</a>
        {%- if section != blank and section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'footer_link' and block.settings.column == 'company' -%}
              <a href="{{ block.settings.url | default: about_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment %} 支付方式 SVG {% endcomment -%}
    <div class="_payments_23f90_190">
      <div class="_methods_8zuyz_1">
        <ul class="_list_8zuyz_8" aria-label="Accepted payment methods">
          <li class="_badge_8zuyz_18" title="iDEAL"><svg viewBox="0 0 40 26" role="img" aria-label="iDEAL"><rect width="40" height="26" rx="3" fill="#fff"></rect><text x="20" y="17.5" text-anchor="middle" font-family="Helvetica, Arial, sans-serif" font-size="10" font-weight="700" fill="#CC0066">iDEAL</text></svg></li>
          <li class="_badge_8zuyz_18" title="Bancontact"><svg viewBox="0 0 40 26" role="img" aria-label="Bancontact"><rect width="40" height="26" rx="3" fill="#fff"></rect><path d="M6 16.5c3.5 0 5.5-2.5 8-5h9l-4.5 5H6Z" fill="#1E3791"></path><path d="M34 9.5c-3.5 0-5.5 2.5-8 5h-9l4.5-5H34Z" fill="#FFD800"></path></svg></li>
          <li class="_badge_8zuyz_18" title="Visa"><svg viewBox="0 0 40 26" role="img" aria-label="Visa"><rect width="40" height="26" rx="3" fill="#fff"></rect><text x="20" y="17.5" text-anchor="middle" font-family="Helvetica, Arial, sans-serif" font-size="10.5" font-weight="700" font-style="italic" fill="#1A1F71">VISA</text></svg></li>
          <li class="_badge_8zuyz_18" title="Mastercard"><svg viewBox="0 0 40 26" role="img" aria-label="Mastercard"><rect width="40" height="26" rx="3" fill="#fff"></rect><circle cx="16.5" cy="13" r="7" fill="#EB001B"></circle><circle cx="23.5" cy="13" r="7" fill="#F79E1B"></circle><path d="M20 7.7a7 7 0 0 0 0 10.6 7 7 0 0 0 0-10.6Z" fill="#FF5F00"></path></svg></li>
          <li class="_badge_8zuyz_18" title="Maestro"><svg viewBox="0 0 40 26" role="img" aria-label="Maestro"><rect width="40" height="26" rx="3" fill="#fff"></rect><circle cx="16.5" cy="13" r="7" fill="#0099DF"></circle><circle cx="23.5" cy="13" r="7" fill="#EB001B"></circle><path d="M20 7.7a7 7 0 0 0 0 10.6 7 7 0 0 0 0-10.6Z" fill="#6C6BBD"></path></svg></li>
          <li class="_badge_8zuyz_18" title="PayPal"><svg viewBox="0 0 40 26" role="img" aria-label="PayPal"><rect width="40" height="26" rx="3" fill="#fff"></rect><text x="20" y="17" text-anchor="middle" font-family="Helvetica, Arial, sans-serif" font-size="9" font-weight="700" font-style="italic" fill="#003087">Pay<tspan fill="#009CDE">Pal</tspan></text></svg></li>
          <li class="_badge_8zuyz_18" title="Apple Pay"><svg viewBox="0 0 40 26" role="img" aria-label="Apple Pay"><rect width="40" height="26" rx="3" fill="#fff"></rect><g fill="#000"><path d="M14.6 9.5c.36-.45.6-1.06.53-1.68-.53.02-1.18.36-1.55.8-.33.39-.63 1.02-.55 1.62.6.05 1.2-.3 1.57-.74Z"></path><path d="M15.13 10.35c-.87-.05-1.6.49-2.02.49-.42 0-1.05-.47-1.73-.46-.89.01-1.71.52-2.17 1.32-.92 1.6-.24 3.97.66 5.27.44.64.97 1.36 1.66 1.33.66-.03.92-.43 1.72-.43.8 0 1.03.43 1.73.42.72-.01 1.17-.65 1.61-1.29.5-.74.71-1.45.72-1.49-.02-.01-1.38-.53-1.4-2.11-.01-1.32 1.08-1.95 1.13-1.98-.62-.91-1.58-1.01-1.91-1.07Z"></path><text x="26" y="17.5" text-anchor="middle" font-family="Helvetica, Arial, sans-serif" font-size="9.5" font-weight="600">Pay</text></g></svg></li>
          <li class="_badge_8zuyz_18" title="Klarna"><svg viewBox="0 0 40 26" role="img" aria-label="Klarna"><rect width="40" height="26" rx="3" fill="#FFB3C7"></rect><text x="20" y="17" text-anchor="middle" font-family="Helvetica, Arial, sans-serif" font-size="9" font-weight="700" fill="#0B051D">Klarna</text></svg></li>
          <li class="_badge_8zuyz_18" title="Bank transfer"><svg viewBox="0 0 40 26" role="img" aria-label="Bank transfer"><rect width="40" height="26" rx="3" fill="#fff"></rect><g fill="none" stroke="#1F2937" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12v6M17 12v6M23 12v6M28 12v6"></path><path d="M10 18.5h20M20 6.5l10 4.5H10l10-4.5Z"></path></g></svg></li>
        </ul>
      </div>
      <span class="_paymentsNote_23f90_201">{{ pay_note }}</span>
    </div>
  </div>

  {%- comment %} 底部版权与官方政策链接栏 {% endcomment -%}
  <div class="_wide_23f90_6 _bottom_23f90_206">
    <div class="_businessDetails_23f90_217">
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name | default: 'TCGHaven' }}</p>
      {%- if shop.email != blank -%}
        <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>
      {%- endif -%}
    </div>
    <div class="_bottomLinks_23f90_231">
      <a href="{{ privacy_url }}">Privacy policy</a>
      <a href="{{ terms_url }}">Terms of service</a>
      <a href="{{ shipping_url }}">Shipping &amp; returns</a>
      <a href="{{ refund_url }}">Refund policy</a>
      <a href="{{ contact_url }}">Contact</a>
    </div>
  </div>
</footer>
