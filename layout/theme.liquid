<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-theme="{{ settings.default_theme_mode | default: 'dark' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <script>
      (function () {
        try {
          var saved = localStorage.getItem('tcg-theme');
          var def = {{ settings.default_theme_mode | default: 'dark' | json }};
          var mode = (saved === 'light' || saved === 'dark') ? saved : (def === 'light' ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', mode);
        } catch (e) {}
      })();
      window.TCG_ROUTES = {
        root: {{ routes.root_url | json }},
        cart_url: {{ routes.cart_url | json }},
        cart_add_url: {{ routes.cart_add_url | append: '.js' | json }},
        cart_add_form_url: {{ routes.cart_add_url | json }},
        cart_change_url: {{ routes.cart_change_url | json }},
        cart_update_url: {{ routes.cart_update_url | json }},
        cart_clear_url: {{ routes.cart_clear_url | json }},
        cart_checkout_url: {{ routes.cart_checkout_url | default: '/checkout' | json }},
        predictive_search_url: {{ routes.predictive_search_url | json }},
        all_products_collection_url: {{ routes.all_products_collection_url | json }},
        search_url: {{ routes.search_url | json }}
      };
      window.Theme = window.Theme || {};
      window.Theme.routes = Object.assign({}, window.Theme.routes || {}, {
        cart_add_url: window.TCG_ROUTES.cart_add_url,
        cart_change_url: window.TCG_ROUTES.cart_change_url,
        cart_update_url: window.TCG_ROUTES.cart_update_url,
        cart_url: window.TCG_ROUTES.cart_url,
        cart_checkout_url: window.TCG_ROUTES.cart_checkout_url,
        predictive_search_url: window.TCG_ROUTES.predictive_search_url,
        search_url: window.TCG_ROUTES.search_url
      });
      window.Theme.translations = Object.assign({}, window.Theme.translations || {}, {
        added: {{ 'actions.added' | t | default: 'Added to cart' | json }},
        cart_count: {{ 'accessibility.cart_count' | t | default: 'Cart count' | json }}
      });
      window.Theme.template = {
        name: {{ template | json }}
      };
      window.Shopify = window.Shopify || {};
      window.Shopify.routes = Object.assign({}, window.Shopify.routes || {}, window.TCG_ROUTES);
    </script>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'logo-mark.png' | asset_url }}">
    {%- endif -%}

    {%- comment %} SEO 元信息（保留 Shopify 原生 meta 渲染） {% endcomment -%}
    {%- render 'meta-tags' -%}

    {%- comment %} 参考站字体：标题 Rubik + 正文 Figtree {% endcomment -%}
    {% # theme-check-disable RemoteAsset %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Rubik:wght@500;600;700;800;900&display=swap"
    >

    {%- comment %} TCG 风格主样式（自包含全部组件、规范排版变量与昼夜模式） {% endcomment -%}
    {{ 'tcg.css' | asset_url | stylesheet_tag }}

    {%- if request.design_mode -%}
      {%- render 'theme-editor' -%}
    {%- endif -%}

    {{ content_for_header }}
    <script>
      window.Shopify = window.Shopify || {};
      window.Shopify.routes = Object.assign({}, window.Shopify.routes || {}, window.TCG_ROUTES || {});
      window.Theme = window.Theme || {};
      window.Theme.routes = Object.assign({}, window.Theme.routes || {}, window.TCG_ROUTES || {});
    </script>
    <script type="application/json" id="tcg-initial-cart-json">{{ cart | json }}</script>
    {% # theme-check-enable RemoteAsset %}
  </head>

  <body class="tcg-body template-{{ request.page_type | handle }}">
    <div id="app">
      {%- comment %} 顶部路由加载进度条 {% endcomment -%}
      <div class="route-progress" aria-hidden="true"></div>

      {%- comment %} 可编辑的浮动胶囊导航（导航项与昼夜切换在主题编辑器中配置） {% endcomment -%}
      {% sections 'header-group' %}

      <div class="route-motion route-enter">
        <main id="MainContent" role="main">
          {%- if request.page_type == 'policy' or request.path contains '/policies/' -%}
            <div class="_page_4xdw3_1">
              <div class="_wide_4xdw3_6">
                <nav class="tcg-policy-nav" aria-label="Store policies">
                  {%- for p in shop.policies -%}
                    {%- if p != blank -%}
                      <a href="{{ p.url }}" class="tcg-policy-tab {% if p.url == request.path %}is-active{% endif %}">{{ p.title }}</a>
                    {%- endif -%}
                  {%- endfor -%}
                </nav>
                <article class="tcg-page-card tcg-policy-wrapper">
                  {{ content_for_layout }}
                </article>
              </div>
            </div>
          {%- else -%}
            {{ content_for_layout }}
          {%- endif -%}
        </main>
      </div>

      {%- comment %} 全局页脚分区组 {% endcomment -%}
      {% sections 'footer-group' %}
    </div>

    {%- comment %} 全部交互逻辑（昼夜模式/轮播/搜索/移动菜单/SKU切换/加购/立即购买/倒计时） {% endcomment -%}
    <script src="{{ 'tcg.js' | asset_url }}" defer></script>
  </body>
</html>
